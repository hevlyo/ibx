#!/usr/bin/env bash
# shellcheck disable=SC2016,SC2317,SC2329 # jq programs are single-quoted on purpose; cleanup_fns calls the rest
# ibx: borrow a disposable instabox.sh sandbox from a shared pool, safely, from any coding agent.
# https://github.com/hevlyo/ibx  (MIT). Run `ibx --help`; the agent-facing guide is SKILL.md.

# bash >= 4.4 is required (inherit_errexit, empty arrays under set -u). macOS ships 3.2: re-exec
# with Homebrew's bash when it is there.
if [ -z "${BASH_VERSION:-}" ] || [ "${BASH_VERSINFO[0]}" -lt 4 ] ||
	{ [ "${BASH_VERSINFO[0]}" -eq 4 ] && [ "${BASH_VERSINFO[1]}" -lt 4 ]; }; then
	if [ -z "${IBX_REEXEC:-}" ]; then
		for b in /opt/homebrew/bin/bash /usr/local/bin/bash; do
			[ -x "$b" ] && IBX_REEXEC=1 exec "$b" "$0" "$@"
		done
	fi
	printf 'ibx: needs bash >= 4.4 (this is %s). macOS: brew install bash\n' "${BASH_VERSION:-not bash}" >&2 || true
	exit 125
fi
unset CDPATH
set -euo pipefail
shopt -s inherit_errexit
umask 077
# Before any child process (uname, cksum, curl -V, jq, mktemp...) inherits it; see load_key.
ENV_KEY=${INSTABOX_API_KEY:-}
export -n ENV_KEY
unset INSTABOX_API_KEY

IBX_VERSION=0.3.1

stderr() { "$@" >&2 || true; } # a closed stderr must not replace the intended exit status

usage() {
	cat <<'EOF'
ibx - borrow a disposable instabox.sh sandbox from a shared pool

Agents
  ibx claim [--json] "<purpose>"         reserve a free pool sandbox and print its name.
                                         The purpose must be ONE quoted argument. Write the name
                                         down: shell variables do not survive between calls.
                                         Metadata is public to the account: keep the purpose generic
  ibx exec [--json] <box> [--stream] [-t SECS] [-i] [--tail N] -- <cmd>
                                         run as the sandbox user with bash -lc (HOME /data/home).
                                         Default 300 s, max 600; -i sends stdin (up to 1 MiB).
                                         One argument = a bash script; several = one quoted command.
                                         --stream opts into SSE; a dropped stream kills the command.
                                         --json prints one object (not with --stream). --tail N keeps the
                                         full output on the box and prints the last N lines.
  ibx run <box> <name> [--replace] -- <cmd>
                                         start a detached job. Prints "started NAME pgid P".
                                         A start is never retried.
  ibx job <box> [name] [--tail N] [--wait S] [--kill]
                                         list jobs, or one job. --wait polls inside the box.
                                         --kill stops its process group.
  ibx put [--force] [--untracked] [--exclude GLOB] <box> <local> <remote>
                                         copy a file or directory in (up to 5 GiB).
                                         A directory is archived; credential-looking paths are refused.
                                         --force is single-file only. Refuses /proc, /sys and /dev.
  ibx get <box> <remote> [local]         copy a file or directory out (a remote directory ends in /).
                                         IBX_GET_MAX defaults to 2G. Archives are checked before extract.
  ibx ssh <box> [--] [cmd...]          ssh through a 1-hour token revoked on exit; streams stdio:
                                           ibx ssh BOX 'bash -s' <script.sh
                                           tar c dir | ibx ssh BOX 'tar x'
                                           ibx ssh BOX 'tar c dir' | tar x
  ibx forward <box> [LOCAL:]REMOTE...   private localhost tunnel, foreground, 1-hour SSH token
  ibx port <box> <port> [name]           publish an HTTP port at a public URL (NO authentication)
  ibx unport <box> <port>                unpublish it
  ibx renew [--json] <box>               refresh your reservation (jobs that run past 24 h)
  ibx release [--no-check] [--json] <box> | --mine
                                         give it back: unpublish ibx and reservation-created ports,
                                         drop its lease and reservation, stop ibx jobs and warn about
                                         processes still running (--no-check skips that report).
                                         --mine: all yours; needs a session/name; a signal stops the rest
                                         and names boxes already released.
  ibx ls [--all | --mine] [--json]       pool sandboxes, state and holders (--all: every sandbox);
                                         --mine finds your live reservations; --json adds Vault/Secrets risk and runtime

Humans
  ibx pool add [--allow-vault] <box>...  let agents claim these sandboxes (refuses Vault secrets
                                         unless --allow-vault)
  ibx pool rm <box>...                   take them out of the pool
  ibx keepalive [--all]                  renew a 1-hour activity lease on reserved pool sandboxes
                                         (--all: every pool sandbox); run it from a timer
  ibx doctor                             check dependencies, key, API access and the pool;
                                         every FAIL line is followed by its next step
  ibx --version | --help

Exit codes: the remote command's for exec/ssh; 124 exec timed out; 75 no free sandbox, cap reached
or local claim lock busy; 125 ibx itself failed (API, network, usage); 255 ssh could not connect;
130/143 when ibx receives SIGINT/SIGTERM. Exec says whether the remote command had started;
release --mine names any box already released and does not start the rest.
Exec disconnect kills its process group, partly-run work included; setsid children can survive.
SSH commands may still run. keepalive exits 1 for real lease failures; a max-run cooldown,
max_run_disabled or a billing block (402) is a skip and exits 0. Leases prevent idle pause, not
the free 480-minute max-run pause.

Environment: INSTABOX_API_KEY (else the file IBX_KEY_FILE, default
${XDG_CONFIG_HOME:-~/.config}/instabox/api-key), INSTABOX_API_URL (https://api.instabox.sh;
another host needs IBX_ALLOW_CUSTOM_API=1), IBX_AGENT_NAME (shown in reservations; default a
pseudonymous id of this user, host and known agent session), IBX_STALE_SECS (reservation age
that counts as abandoned, 86400), IBX_ALLOW_ANY=1 (user-only: bypass pool and holder checks), IBX_ALLOW_VAULT=1
(claim sandboxes that receive Vault secrets), IBX_ALLOW_SECRETS=1 (proxy Secrets selected by
name and scoped to named hosts only, user-only; the "all" selection, env Secrets, unknown
delivery and every-host proxy Secrets stay refused), IBX_GET_MAX (download cap, default 2G),
IBX_MAX_CLAIMS (live reservations per agent, default 3; 0 disables the cap), IBX_STATE_DIR (an atomic mkdir lock, default directory
${XDG_STATE_HOME:-~/.local/state}/ibx).
claim, renew and release accept --json anywhere after the command. JSON includes warnings;
errors have error.code (no_free_sandbox, claim_limit, lock_busy, auth, account_blocked, failed,
interrupted, held_by_other, not_held, ambiguous_identity) and error.message. lock_busy exits 75
after waiting up to 5 minutes for a usable local lock. Work commands refuse another agent's live reservation (held_by_other, 125).
Unreserved or abandoned boxes warn: ibx claim first. Renew requires your live reservation
(not_held, 125); release stays idempotent. ls, doctor and keepalive do not check ownership.
ls --mine --json returns {agent,agentSource,boxes}; release --mine --json returns
{released:[names],failed:[{name,error}],warnings}. Partial release failure exits 125.
EOF
}

case "${1:-}" in
"" | -h | --help) usage; exit 0 ;;
--version | version) echo "ibx $IBX_VERSION"; exit 0 ;;
esac

if [ "$1" = exec ]; then
	help_box='' help_timeout=
	for a in "${@:2}"; do
		case "$a" in -h | --help) usage; exit 0 ;; --) break ;; esac
		if [ -n "$help_timeout" ]; then help_timeout=; continue; fi
		if [ -z "$help_box" ]; then [ "$a" != --stream ] || continue; help_box=1; continue; fi
		case "$a" in -i | --stream) ;; -t) help_timeout=1 ;; *) break ;; esac
	done
elif [ "$1" = ssh ]; then
	for a in "${@:2}"; do
		case "$a" in -h | --help) usage; exit 0 ;; *) break ;; esac
	done
else
	for a in "${@:2}"; do case "$a" in -h | --help) usage; exit 0 ;; esac; done
fi

API=${INSTABOX_API_URL:-https://api.instabox.sh}
STALE_SECS=${IBX_STALE_SECS:-86400}
LEASE=ibx-keepalive
IBX_MAXTIME=${IBX_MAXTIME:-} # set during claim: caps each API call, retries included
LABEL=''                     # the sandbox name, for messages
MAX_CLAIMS=${IBX_MAX_CLAIMS:-3}
STATE_HOME=${XDG_STATE_HOME:-${HOME:+$HOME/.local/state}}
STATE_DIR=${IBX_STATE_DIR:-${STATE_HOME:+$STATE_HOME/ibx}}
while [[ $STATE_DIR != / && $STATE_DIR == */ ]]; do STATE_DIR=${STATE_DIR%/}; done
AGENT_SOURCE='per host'
session_id=
if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then
	session_id=$CLAUDE_CODE_SESSION_ID AGENT_SOURCE=CLAUDE_CODE_SESSION_ID
elif [ -n "${CODEX_THREAD_ID:-}" ]; then
	session_id=$CODEX_THREAD_ID AGENT_SOURCE=CODEX_THREAD_ID
fi
LOCK_HOST=$(uname -n)
LOCK_NS=$(readlink /proc/self/ns/pid 2>/dev/null) || LOCK_NS=
LOCK_OWNER=$(printf '%s\t%s\t%s' "$$" "$LOCK_HOST" "$LOCK_NS")
reap_lock_held=
host_id=$(printf '%s@%s%s' "${USER:-}" "$LOCK_HOST" "${session_id:+:$session_id}" | cksum | cut -d' ' -f1)
AGENT=${IBX_AGENT_NAME:-agent-$host_id}
[ -z "${IBX_AGENT_NAME:-}" ] || AGENT_SOURCE=IBX_AGENT_NAME
AGENT=${AGENT//[^A-Za-z0-9@._:-]/_}
AGENT=${AGENT:0:64}

JSON=
EXEC_JSON=
RELEASE_NO_CHECK=
case "$1" in
claim | renew | release | exec | run | job | put | get)
	args=()
	for a in "$@"; do
		if [ "$a" = --json ]; then JSON=1; else args+=("$a"); fi
	done
	set -- "${args[@]}"
	;;
esac
[ -z "$JSON" ] || exec {JSON_FD}>&1 # die can run inside a command substitution
COMMAND=$1
[ "$COMMAND" != exec ] || [ -z "$JSON" ] || EXEC_JSON=1
STREAM=
EXEC_SAFE=
SIGNAL_FD=
if exec {SIGNAL_FD}>&2; then :; else SIGNAL_FD=; fi
kept_claim=null
curl_pid=
file_transfer=
ssh_pid=
ssh_filter_pid=
sleep_pid=
exec_phase=not_started
bulk_signal=
bulk_status=
interrupt_detail=
release_status_file=

tmp=$(mktemp -d "${TMPDIR:-/tmp}/ibx.XXXXXX") || {
	stderr printf 'ibx: could not create temporary directory\n'
	[ -z "$JSON" ] || printf '%s\n' '{"error":{"code":"failed","message":"could not create temporary directory"},"warnings":[]}' >&"$JSON_FD"
	exit 125
}
: >"$tmp/warnings"
cleanup_fns=()
main_pid=$BASHPID
cleanup() {
	local rc=$?
	set +e
	[ "$BASHPID" = "$main_pid" ] || return 0
	# release --mine reads this from the parent temp dir after wait returns.
	[ -z "$release_status_file" ] || printf '%s\n' "$rc" >"$release_status_file"
	trap '' INT TERM
	local f output
	if [ -n "$sleep_pid" ]; then
		kill "$sleep_pid" 2>/dev/null || true
		wait "$sleep_pid" 2>/dev/null || true
	fi
	if [ -n "$curl_pid" ]; then kill "$curl_pid" 2>/dev/null || true; wait "$curl_pid" 2>/dev/null || true; fi
	if [ -n "$ssh_pid" ]; then kill "$ssh_pid" 2>/dev/null || true; wait "$ssh_pid" 2>/dev/null || true; fi
	if [ -n "$ssh_filter_pid" ]; then kill "$ssh_filter_pid" 2>/dev/null || true; wait "$ssh_filter_pid" 2>/dev/null || true; fi
	for f in "${cleanup_fns[@]}"; do "$f" || true; done
	if [ "$rc" != 0 ] && [ ! -s "$tmp/result" ] && [ ! -s "$tmp/error" ]; then
		json_error failed "exit $rc" "$kept_claim"
	fi
	if [ -n "$JSON" ]; then
		output=$tmp/result
		[ ! -s "$tmp/error" ] || output=$tmp/error
		if command -v jq >/dev/null; then
			if jq -c --slurpfile w "$tmp/warnings" '. + {warnings:$w}' "$output" >"$tmp/output"; then
				cat "$tmp/output" >&"$JSON_FD"
			else
				printf '%s\n' '{"error":{"code":"failed","message":"could not serialize JSON"},"warnings":[]}' >&"$JSON_FD"
			fi
		else
			printf '%s\n' '{"error":{"code":"failed","message":"jq is missing"},"warnings":[]}' >&"$JSON_FD"
		fi
	fi
	rm -rf "$tmp"
	return "$rc"
}
note_bulk_signal() { # release --mine: remember the signal and let the in-flight box finish
	bulk_signal=$1
	bulk_status=$2
}
interrupted() {
	local message
	if [ -n "$interrupt_detail" ]; then
		message=$interrupt_detail
	else
		message="interrupted by SIG$1: a remote command it started may still be running"
		case $COMMAND in exec | put | get | ssh | forward)
			# exec_phase: not_started (resolving, waiting for a slot, a cooldown or the box), partial
			# (a request or session that runs a command is open), yes (the result arrived).
			if [ "$exec_phase" = not_started ]; then
				message="interrupted by SIG$1 before anything started in the sandbox"
			elif [ "$exec_phase" = yes ]; then
				message="interrupted by SIG$1 after the remote command finished"
			elif [ "$COMMAND" != ssh ] && [ "$COMMAND" != forward ]; then
				message="interrupted by SIG$1: the remote command was killed when the connection closed; it may have run partly; processes it started in a new session (setsid) keep running"
			fi ;;
		esac
		case $file_transfer in
		PUT) message="interrupted by SIG$1: the file upload stopped; the remote file may have been replaced; check before retrying" ;;
		GET) message="interrupted by SIG$1: the file download stopped; check the local destination" ;;
		esac
	fi
	if [ "$kept_claim" != null ]; then
		message+="; sandbox still reserved: $(jq -r 'map(.name) | join(", ")' <<<"$kept_claim")"
	fi
	if [ -n "$SIGNAL_FD" ]; then warn "$message" 2>&"$SIGNAL_FD"; else warn "$message"; fi
	json_error interrupted "$message" "$kept_claim"
	exit "$2"
}
trap cleanup EXIT
trap 'interrupted INT 130' INT
trap 'interrupted TERM 143' TERM

json_error() { # commit one complete object; only the main EXIT cleanup prints it
	[ -n "$JSON" ] || return 0
	local candidate=$tmp/error.$BASHPID.$RANDOM
	[ ! -e "$tmp/error" ] || return 0
	if command -v jq >/dev/null; then
		jq -cn --arg c "$1" --arg m "$2" --argjson held "${3:-null}" '
			def clean: gsub("[\u0000-\u001f\u007f-\u009f]"; " ");
			{error:({code:$c, message:($m | clean)} +
				(if $held == null then {} else {held:$held} end)), warnings:[]}' >"$candidate" ||
			printf '%s\n' '{"error":{"code":"failed","message":"could not serialize JSON"},"warnings":[]}' >"$candidate"
	else
		printf '%s\n' '{"error":{"code":"failed","message":"jq is missing"},"warnings":[]}' >"$candidate"
	fi
	# Hard-link creation is atomic and refuses an existing destination, including another error.
	ln "$candidate" "$tmp/error" 2>/dev/null || true
}
fatal_check() { [ ! -s "$tmp/fatal" ] || die "API refused the request"; }
exec_json_fail() { # api-code message: one exec --json object, then exit 125
	local err=$1 message=$2 ran=partial
	case $message in
	*"did not run"* | *"did not start"* | *"rejected"*) ran=no; err=not_started ;;
	esac
	case $1 in
	auth) ran=no; err=auth ;;
	account_blocked) ran=no; err=account_blocked ;;
	esac
	case $message in
	*"may have run"* | *"may or may not"* | *"cut off"* | *"was killed"*) ran=partial; err=cut_off ;;
	esac
	jq -n --arg box "${LABEL:-}" --arg ran "$ran" --arg err "$err" --arg m "$message" \
		'{box:$box,ran:$ran,exitCode:null,timedOut:false,signal:null,truncated:false,invalidUtf8:false,stdout:"",stderr:"",warnings:[],error:{code:$err,message:$m}}' >"$tmp/result"
	stderr printf 'ibx: %s\n' "$message"
	exit 125
}
die() { # fatal API refusals survive command substitutions and outer handlers
	local code=failed message="$*"
	if [ -s "$tmp/fatal" ]; then
		code=$(jq -r .code "$tmp/fatal") message=$(jq -r .message "$tmp/fatal")
	fi
	if [ -n "$EXEC_JSON" ]; then
		EXEC_JSON=
		exec_json_fail "$code" "$message"
	fi
	stderr printf 'ibx: %s\n' "$message"
	json_error "$code" "$message" "$kept_claim"
	exit 125
}
warn() {
	stderr printf 'ibx: %s\n' "$*"
	if [ -n "$JSON" ] && command -v jq >/dev/null; then
		jq -cn --arg m "$*" '$m | gsub("[\u0000-\u001f\u007f-\u009f]"; " ")' >>"$tmp/warnings"
	fi
}

sleep_for() { # wait is interruptible; cleanup reaps the child so it cannot hold stdout open
	sleep "$1" &
	sleep_pid=$!
	wait "$sleep_pid"
	sleep_pid=
}

normalize_config() { # value label -> NORMALIZED; shared rules with install.sh
	local path=$1 label=$2
	# shellcheck disable=SC2088 # expand only a literal leading ~ or ~/
	case $path in
	"~") path=${HOME:-} ;;
	"~/"*) [ -n "${HOME:-}" ] || die "$label needs HOME to expand ~"; path=$HOME/${path#"~/"} ;;
	esac
	case $path in /*) ;; *) die "$label must be an absolute path (a leading ~ or ~/ is allowed)" ;; esac
	while [ "$path" != / ] && [ "${path%/}" != "$path" ]; do path=${path%/}; done
	NORMALIZED=$path
}
if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
	normalize_config "$CLAUDE_CONFIG_DIR" CLAUDE_CONFIG_DIR; CLAUDE_CONFIG_DIR=$NORMALIZED
fi
if [ -n "${CODEX_HOME:-}" ]; then
	normalize_config "$CODEX_HOME" CODEX_HOME; CODEX_HOME=$NORMALIZED
fi
if [ -n "${XDG_CONFIG_HOME:-}" ]; then
	normalize_config "$XDG_CONFIG_HOME" XDG_CONFIG_HOME; XDG_CONFIG_HOME=$NORMALIZED
fi
CONFIG_DIR=${XDG_CONFIG_HOME:-${HOME:+$HOME/.config}}
KEYFILE=${IBX_KEY_FILE:-${INSTABOX_KEY_FILE:-${CONFIG_DIR:+$CONFIG_DIR/instabox/api-key}}}

# The key goes only to api.instabox.sh unless told otherwise; plain http only to a local test server.
if [[ $API =~ ^http://(127\.0\.0\.1|localhost)(:[0-9]+)?$ ]]; then
	:
elif [[ $API =~ ^https://([A-Za-z0-9.-]+)(:[0-9]+)?$ ]]; then
	[ "${BASH_REMATCH[1]}" = api.instabox.sh ] || [ "${IBX_ALLOW_CUSTOM_API:-}" = 1 ] ||
		die "INSTABOX_API_URL points at ${BASH_REMATCH[1]}, not api.instabox.sh: set IBX_ALLOW_CUSTOM_API=1 if that is intended"
else
	die "INSTABOX_API_URL must be https://host"
fi
[[ $MAX_CLAIMS =~ ^[0-9]+$ ]] || die "IBX_MAX_CLAIMS must be a non-negative integer"
# jq accepts decimal numbers, including values too large for shell arithmetic.
MAX_CLAIMS=$(printf '%s\n' "$MAX_CLAIMS" | sed 's/^0*//; s/^$/0/')
[[ $STALE_SECS =~ ^[0-9]+$ ]] || die "IBX_STALE_SECS must be a number of seconds"

deps_ok() { # prints problems, one per line
	command -v curl >/dev/null || echo "curl is missing"
	command -v jq >/dev/null || echo "jq is missing (macOS: brew install jq)"
	command -v ssh >/dev/null || echo "ssh is missing (needed only by ibx ssh)"
	if command -v curl >/dev/null; then
		local v
		v=$(curl -q -V | awk 'NR==1{print $2}')
		awk -v v="$v" 'BEGIN{split(v,a,"."); exit !((a[1]>7)||(a[1]==7&&a[2]>=71))}' ||
			echo "curl $v is too old (need 7.71+)"
	fi
	if command -v jq >/dev/null; then
		jq -n '"a" | sub("a"; "b") | IN("b")' >/dev/null 2>&1 || echo "jq is too old (need 1.6+)"
	fi
}
if [ "$1" != doctor ]; then
	problems=$(deps_ok | grep -v 'needed only by' || true)
	[ -z "$problems" ] || die "$problems"
fi

# The key stays in this (unexported) variable and reaches curl through stdin (-H @-): it is never
# in argv, in the environment of child processes, or in a file that a SIGKILL would leave behind.
AUTH=
export -n AUTH
KEY_SOURCE=
load_key() {
	local key
	export -n key
	key=$ENV_KEY
	KEY_SOURCE=INSTABOX_API_KEY
	if [ -z "$key" ] && [ -r "$KEYFILE" ]; then
		[ -z "$(find "$KEYFILE" -prune \( -perm -040 -o -perm -004 \) 2>/dev/null)" ] ||
			warn "WARNING: $KEYFILE is readable by other users: chmod 600 $(printf %q "$KEYFILE")"
		key=$(tr -d '[:space:]' <"$KEYFILE")
		KEY_SOURCE=$KEYFILE
	fi
	[[ $key =~ ^ibk_[a-z2-7]{20,}$ ]] || return 1
	AUTH="Authorization: Bearer $key"
}
if [ "$1" != doctor ]; then
	load_key || die "no API key: set INSTABOX_API_KEY or write it to $KEYFILE (chmod 600)"
	ENV_KEY=
fi

idem() { od -An -N12 -tx1 /dev/urandom | tr -d ' \n'; }
now_precise() { jq -nr 'now * 1000 | floor | . as $ms | (($ms / 1000 | floor | todate | rtrimstr("Z")) + "." + ((1000 + $ms % 1000 | tostring)[1:]) + "Z")'; }
now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }
size_of() { wc -c <"$1" | tr -d ' '; }
shuffle() { # lines of stdin in random order (no shuf on macOS)
	awk -v s="$(od -An -N4 -tu4 /dev/urandom | tr -d ' ')" 'BEGIN { srand(s) } { printf "%.9f\t%s\n", rand(), $0 }' |
		sort -n | cut -f2-
}
printable() { LC_ALL=C tr -d '\000-\010\013-\037\177'; } # drop control chars from text shown to a terminal

# api METHOD PATH [BODY-FILE]: prints the body of a 2xx reply; otherwise prints the body (an error
# envelope) to stderr and returns 1. The API sometimes drops TLS mid-reply, so idempotent calls are
# retried (the body goes to a file, which curl rewrites on a retry). exec and SSH-token creation
# are never retried: the command would run twice, or a second token would be left behind.
# curl -q skips ~/.curlrc, which could otherwise turn on verbose output and print the key; -g (on
# every curl here) keeps {} and [] in URLs and file names literal.
api() {
	local m=$1 p=$2 code rc
	case "$p" in *..* | *'#'* | *[[:space:]]*) stderr printf '{"error":{"code":"bad_path","message":"refusing path %s"}}\n' "$p"; return 1 ;; esac
	local args=(-q -g -sS -o "$tmp/resp" -w '%{http_code}' -X "$m" -H @- -H 'Content-Type: application/json')
	[ $# -ge 3 ] && args+=(--data-binary @"$3")
	case "$m $p" in
	"POST "*/exec) args+=(-m "${IBX_EXEC_MAXTIME:-700}") ;;
	"POST "*/ssh-tokens) args+=(-m 60) ;;
	*)
		args+=(-m "${IBX_MAXTIME:-120}" --retry 3 --retry-delay 2 --retry-all-errors)
		[ -n "${IBX_MAXTIME:-}" ] && args+=(--retry-max-time "$IBX_MAXTIME")
		;;
	esac
	# Routes that take an Idempotency-Key get a fresh one; curl's retries reuse it.
	case "$m $p" in GET* | "POST "*/exec | "POST "*/ssh-tokens | PUT* | "POST "*/ports | "DELETE "*/ports/* | "DELETE "*/activity-leases/* | "DELETE "*/ssh-tokens/* | "POST "*/wake) ;;
	*) args+=(-H "Idempotency-Key: ibx-$(idem)") ;;
	esac
	if [[ $m == POST && $p == */exec ]]; then
		curl "${args[@]}" "$API$p" < <(printf '%s\n' "$AUTH") >"$tmp/http-status" &
		curl_pid=$!
		rc=0
		wait "$curl_pid" || rc=$?
		curl_pid=
		code=$(cat "$tmp/http-status")
	else
		rc=0
		code=$(printf '%s\n' "$AUTH" | curl "${args[@]}" "$API$p") || rc=$?
	fi
	if [ "$rc" != 0 ]; then
		stderr printf '{"error":{"code":"transport","message":"curl exit %s on %s %s","retryable":false}}\n' "$rc" "$m" "$p"
		return 1
	fi
	api_refusal "$code" "$tmp/resp"
	case "$code" in
	2??) cat "$tmp/resp" ;;
	*) stderr cat "$tmp/resp"; stderr echo; return 1 ;;
	esac
}
err_code() { jq -r '.error.code // empty' 2>/dev/null <"$1" || true; }

auth_code() {
	case $1 in missing_key | malformed_key | invalid_key | expired_key | revoked_key | session_expired | missing_scope | insufficient_scope | unauthenticated | api_key_expired | api_key_revoked) return 0 ;; *) return 1 ;; esac
}
api_refusal() { # status body-file: remember account-wide failures, including from subshells
	local code message kind=
	code=$(err_code "$2")
	if [ "$1" = 401 ] || auth_code "$code"; then kind=auth; fi
	case $code in credit_exhausted | spend_limit_reached | subscription_required | payment_method_required | payment_failed) kind=account_blocked ;; esac
	[ "$1" != 402 ] || kind=account_blocked
	[ -n "$kind" ] || return 0
	message=$(jq -r "$JQ_DEFS"' .error | [.code,.message,.hint,((.requiredScopes // []) | join(", "))] | map(select(. != null and . != "") | tostring | clean) | join("; ")' "$2" | printable)
	if [ "$kind" = auth ] && [ "$COMMAND" = exec ]; then message="exec rejected (the command did not run); $message"; fi
	if [ "$kind" = auth ]; then message+="; ask the user to fix this key; never look for another one"; fi
	jq -cn --arg c "$kind" --arg m "$message" '{code:$c,message:$m}' >"$tmp/fatal"
}

all_machines() { # every sandbox of the account (GET /v1/machines is paged)
	local page cursor='' acc='[]'
	while :; do
		page=$(api GET "/v1/machines?limit=200${cursor:+&cursor=$cursor}") || return 1
		acc=$(jq -c --argjson a "$acc" '$a + .machines' <<<"$page") || return 1
		cursor=$(jq -r '.nextCursor // empty' <<<"$page")
		[[ $cursor =~ ^[A-Za-z0-9_=-]*$ ]] || return 1
		[ -n "$cursor" ] || break
	done
	printf '%s\n' "$acc"
}

# jq helpers. timestamp: an RFC 3339 date-time (any offset, fraction, lower-case t/z) in epoch
# seconds; null, never empty, for anything else, so callers must handle null. age(now): seconds
# since the reservation was made; null when there is none; "invalid" when ibx.claim.at cannot be
# parsed or lies in the future. free: no live reservation. available: max-run allows a wake now; an
# unreadable cooldownUntil counts as a cooldown. scoped_proxy: a Secret with proxy delivery to named
# hosts only; omitted or empty hosts mean every host (schemas.SecretHosts), as does "*".
JQ_DEFS='def timestamp: if type == "string" then ((try (ascii_upcase |
		capture("^(?<base>[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2})(?:\\.(?<fraction>[0-9]+))?(?<zone>Z|[+-][0-9]{2}:[0-9]{2})$") |
		(.base + "Z" | fromdateiso8601) + (("0." + (.fraction // "0")) | tonumber) -
		(if .zone == "Z" then 0 else (if .zone[0:1] == "-" then -1 else 1 end) *
			((.zone[1:3] | tonumber) * 3600 + (.zone[4:6] | tonumber) * 60) end)) catch null) // null)
		else null end;
	def age($now): (.metadata["ibx.claim.at"] // "") as $a | if $a == "" then null else
		($a | timestamp) as $t | if $t == null or ($now - $t) < -300 then "invalid" else $now - $t end end;
	def free($now; $stale): age($now) as $g | $g == null or ($g != "invalid" and $g > $stale);
	def inpool: (.metadata["ibx.pool"] // "") == "1";
	def vaulton: if .vault == false then false else true end;
	def pauses: if (.maxRunMinutes // -1) > 0 then (.runStartedAt | timestamp) as $s |
		if $s == null then null else ($s + .maxRunMinutes * 60 | todate) end else null end;
	def available($now): (.maxRunMinutes // -1) != 0 and ((.cooldownUntil // "") as $c |
		$c == "" or (($c | timestamp) as $t | $t != null and $t <= $now));
	def scoped_proxy: .delivery == "proxy" and ((.hosts // []) | type == "array" and length > 0 and index("*") == null);
	def clean: if type == "string" then gsub("[\u0000-\u001f\u007f-\u009f]"; " ") else . end;'

resolve() { # [--pool] name-or-id -> id. With --pool, only pool sandboxes (agent commands).
	local pool='' ms id
	[ "$1" = --pool ] && { pool=1; shift; }
	ms=$(all_machines) || die "could not list sandboxes"
	id=$(jq -r --arg r "$1" '.[] | select(.id == $r or .name == $r) | .id' <<<"$ms") || die "bad sandbox list"
	[ -n "$id" ] || die "no sandbox named $1 (ibx ls --all)"
	[[ $id =~ ^m_[a-z2-7]{26}$ ]] || die "unexpected sandbox id from the API"
	if [ -n "$pool" ] && [ "${IBX_ALLOW_ANY:-}" != 1 ] &&
		[ "$(jq -r --arg i "$id" "$JQ_DEFS"' .[] | select(.id == $i) | inpool' <<<"$ms")" != true ]; then
		die "$1 is not in the pool: agents only use pool sandboxes (ibx ls). Ask the user."
	fi
	if [ -n "$pool" ] && [ "${IBX_ALLOW_ANY:-}" != 1 ]; then
		case $COMMAND in exec | put | get | ssh | forward | port | unport | renew | release | run | job)
			local m owned held message
			m=$(jq -c --arg id "$id" '.[] | select(.id == $id)' <<<"$ms")
			owned=$(jq -r --arg by "$AGENT" --argjson now "$(date +%s)" --argjson stale "$STALE_SECS" "$JQ_DEFS"'
				age($now) as $age | .metadata["ibx.claim.by"] == $by and
				$age != null and ($age == "invalid" or $age <= $stale)' <<<"$m")
			if [ "$owned" != true ]; then
				if jq -e --arg by "$AGENT" --argjson now "$(date +%s)" --argjson stale "$STALE_SECS" "$JQ_DEFS"'
					.metadata["ibx.claim.by"] != $by and (free($now; $stale) | not)' <<<"$m" >/dev/null; then
					held=$(held_claims "$ms" "$AGENT")
					message=$(jq -r "$JQ_DEFS"' "\(.name | clean) is held by \(.metadata["ibx.claim.by"] // "?" | clean) since \(.metadata["ibx.claim.at"] | clean): \(.metadata["ibx.claim.purpose"] // "" | clean)"' <<<"$m")
					message+="; you hold: $(jq -r 'if length == 0 then "none" else map(.name) | join(", ") end' <<<"$held")"
					json_error held_by_other "$message" "$held"
					die "$message"
				fi
				if [ "$COMMAND" = renew ]; then
					message="$1 is not reserved by you; ibx claim first (no live reservation to renew)"
					json_error not_held "$message"
					die "$message"
				fi
				[ "$COMMAND" = release ] || warn "$1 not reserved by you; ibx claim first or another agent may take it"
			fi ;;
		esac
	fi
	printf '%s' "$id"
}

vault_items() { # id -> number of Vault items written into the sandbox (0 when the Vault is off)
	local r
	r=$(api GET "/v1/machines/$1/vault" 2>"$tmp/verr") || {
		if [ "$(err_code "$tmp/verr")" = permission_denied ]; then
			warn "cannot inspect the Vault of ${2:-$1} with this key (workspace key or not its creator); recreate it with --no-vault --secrets none"
		fi
		[ "$(err_code "$tmp/verr")" = not_found ] && { echo 0; return 0; } # a server without Vault
		return 1
	}
	jq -er 'if (.enabled | type) != "boolean" or (.items | type) != "array" then error("invalid Vault response") else (if .enabled == false then 0 else (.items | length) end) + ((.applied.files // []) | length) + ((.applied.kept // []) | length) end' <<<"$r"
}

org_secrets_off() { # 0 when GET /v1/usage says this server has no Org Secrets; 1 if it has; 2 unknown
	local r
	if [ ! -s "$tmp/org-secrets-limit" ]; then
		r=$(api GET /v1/usage) || return 2
		jq -r '.limits.orgSecrets == true' <<<"$r" >"$tmp/org-secrets-limit" || return 2
	fi
	[ "$(cat "$tmp/org-secrets-limit")" = false ]
}
# secrets_state id: 0 clean, only on an explicit empty selection; 1 Secrets are selected, pending or
# left behind; 2 they could not be inspected (API error, unexpected reply). Never prints values.
# A 404 counts as a server without Org Secrets only when usage says so. IBX_ALLOW_SECRETS=1 also
# accepts proxy Secrets selected by name and scoped to named hosts, never "all".
secrets_state() {
	local r rc=0
	if ! r=$(api GET "/v1/machines/$1/secrets" 2>"$tmp/serr"); then
		if [ "$(err_code "$tmp/serr")" = not_found ] && org_secrets_off; then return 0; fi
		return 2
	fi
	jq -e --arg allow "${IBX_ALLOW_SECRETS:-}" "$JQ_DEFS"'
		(.secrets | type == "array" and length == 0) and
		((.envSecrets // []) | type == "array" and length == 0) and
		((.items // []) | type == "array") and ((.guest.items // []) | type == "array" and length == 0) and
		(.proxy.state != "pending") and (.guest.state != "pending") and
		(if $allow == "1" then all(.items[]?; scoped_proxy) else (.items // []) == [] end)
		or ($allow == "1" and (.secrets | type == "array" and all(.[]; type == "string")) and
		 ((.envSecrets // []) == []) and ((.guest.items // []) == []) and
		 (.guest.state != "pending") and (.proxy.state != "pending") and
		 (.items | type == "array") and all(.items[]; scoped_proxy))' <<<"$r" >/dev/null || rc=$?
	# jq -e: 1 is a false result; anything else (no output, an error) is an unreadable reply.
	[ "$rc" -le 1 ] || return 2
	return "$rc"
}
cooldown_wait() { # error-file machine-json deadline: safe only when no command started
	local seconds until
	until=$(jq -r "$JQ_DEFS"' .cooldownUntil // empty | clean' <<<"$2")
	seconds=$(jq -r --argjson m "$2" "$JQ_DEFS"'
		.error.retryAfterSeconds // (((($m.cooldownUntil | timestamp) // 0) - now) | ceil)' "$1")
	if [[ $seconds =~ ^[0-9]+$ ]] && [ "$seconds" -gt 0 ] && [ "$seconds" -lt "$(( $3 - SECONDS - 2 ))" ]; then
		sleep_for "$((seconds + RANDOM % 2))"
		return 0
	fi
	warn "${LABEL:-sandbox} is in its max-run cooldown until ${until:-the server permits a wake}"
	return 1
}

wait_op() { # operation-id: waits up to 8 minutes
	local op=$1 r end=$((SECONDS + 480))
	[ -n "$op" ] || return 0
	[[ $op =~ ^[A-Za-z0-9_-]+$ ]] || { warn "unexpected operation id"; return 1; }
	while [ $SECONDS -lt $end ]; do
		if ! r=$(api GET "/v1/operations/$op?wait=25s" 2>"$tmp/operr"); then
			fatal_check
			[ "$(err_code "$tmp/operr")" = not_found ] && { warn "operation $op not found"; return 1; }
			sleep_for 3
			continue
		fi
		case "$(jq -r .state <<<"$r")" in
		succeeded) return 0 ;;
		failed) warn "operation $op failed: $(jq -c .error <<<"$r")"; return 1 ;;
		esac
	done
	warn "operation $op still running after 8 minutes"
	return 1
}

# ensure_running ID: returns 0 once the sandbox runs (waking an idle-paused one, resuming a paused
# one, starting a stopped one, waiting out an operation in progress), 1 if it cannot.
ensure_running() {
	local m op opid state action nm=$1 end=$((SECONDS + 600)) notready=
	while [ $SECONDS -lt $end ]; do
		m=$(api GET "/v1/machines/$1") || { [ ! -s "$tmp/fatal" ] || return 3; sleep_for 3; continue; }
		nm=$(jq -r "$JQ_DEFS"' .name // "" | clean' <<<"$m")
		[ -n "$nm" ] || nm=$1
		state=$(jq -r .state <<<"$m")
		opid=$(jq -r '.operationId // empty' <<<"$m")
		if [ "$state" = running ]; then
			[ "$(jq -r '.runtime.ready // false' <<<"$m")" = true ] && return 0
			: "${notready:=$SECONDS}"
			# exec works before the runtime reports ready; do not block on it forever.
			[ $((SECONDS - notready)) -lt 60 ] || { warn "$nm runs but its runtime is not ready; continuing"; return 0; }
			sleep_for 3
			continue
		fi
		if [ -n "$opid" ]; then wait_op "$opid" || return 1; continue; fi
		case "$state" in
		suspended | stopped)
			action=start
			[ "$state" = suspended ] && action=resume
			[ "$state" = suspended ] && [ -n "$(jq -r '.autoSuspendedAt // empty' <<<"$m")" ] && action=wake # concurrent callers share it
			if op=$(api POST "/v1/machines/$1/$action" 2>"$tmp/err"); then
				# resume and start answer with an Operation (202); wake answers with the Machine (200).
				if [ "$action" != wake ]; then wait_op "$(jq -r '.id // empty' <<<"$op")" || return 1; fi
				m=$(api GET "/v1/machines/$1") || true
				if [ "$(jq -r '.runtime.processesPreserved' <<<"$m" 2>/dev/null)" = false ]; then
					warn "WARNING: $nm came back with a fresh boot: processes started before the pause are gone"
				fi
			elif [ "$(err_code "$tmp/err")" = operation_conflict ]; then
				wait_op "$(jq -r '.error.operationId // empty' <"$tmp/err")" || return 1
			elif [ "$(err_code "$tmp/err")" = machine_cooldown ]; then
				cooldown_wait "$tmp/err" "$m" "$end" || return 1
			elif [ -s "$tmp/fatal" ]; then
				return 3
			else
				stderr cat "$tmp/err"
				return 1
			fi
			;;
		creating | starting | resuming | stopping | suspending) sleep_for 3 ;;
		*) warn "$nm is $state"; return 1 ;;
		esac
	done
	warn "$nm did not start within 10 minutes"
	return 1
}

set_meta() { # id jq-filter [jq args...]: read-modify-write of the sandbox metadata. Leaves the
	# Machine as read in $tmp/meta-before and the PATCH reply in $tmp/meta-response.
	local id=$1 filter=$2 m
	shift 2
	rm -f "$tmp/meta"
	m=$(api GET "/v1/machines/$id") || return 1
	printf '%s\n' "$m" >"$tmp/meta-before"
	if [ -n "${CLAIM_WRITE_TOKEN:-}" ] && ! jq -e --arg t "$CLAIM_WRITE_TOKEN" \
		--argjson now "$(date +%s)" --argjson stale "$STALE_SECS" "$JQ_DEFS"'
		inpool and (free($now; $stale) or .metadata["ibx.claim.token"] == $t)' <<<"$m" >/dev/null; then
		return 2
	fi
	jq "$@" "{metadata: ((.metadata // {}) | $filter)}" <<<"$m" >"$tmp/meta" || return 1
	api PATCH "/v1/machines/$id" "$tmp/meta" >"$tmp/meta-response" || return 1
}
set_claim() { # id claim-object-json ({} clears): replaces only the ibx.claim.* keys
	set_meta "$1" 'with_entries(select(.key | startswith("ibx.claim.") | not)) + $c' --argjson c "$2"
}

state_dir_ok() {
	local unsafe
	[ -n "$STATE_DIR" ] && [ ! -L "$STATE_DIR" ] && mkdir -p "$STATE_DIR" 2>/dev/null &&
		[ -O "$STATE_DIR" ] && [ -w "$STATE_DIR" ] || return 1
	unsafe=$(find "$STATE_DIR" -prune \( -perm -020 -o -perm -002 \) 2>/dev/null) || return 1
	[ -z "$unsafe" ]
}
claim_unlock() {
	if [ "$claim_lock_kind" = mkdir ]; then
		if [ "$(cat "$STATE_DIR/claim.lock/pid" 2>/dev/null)" = "$LOCK_OWNER" ]; then
			rm -rf "$STATE_DIR/claim.lock" 2>/dev/null || true
		else
			rmdir "$STATE_DIR/claim.lock" 2>/dev/null || true
		fi
	fi
	claim_lock_kind=
}
reap_unlock() {
	if [ -n "$reap_lock_held" ] &&
		[ "$(cat "$STATE_DIR/claim.reap/pid" 2>/dev/null)" = "$LOCK_OWNER" ]; then
		rm -rf "$STATE_DIR/claim.reap" 2>/dev/null || true
	elif [ -n "$reap_lock_held" ] && [ ! -e "$STATE_DIR/claim.reap/pid" ]; then
		rmdir "$STATE_DIR/claim.reap" 2>/dev/null || true
	fi
	reap_lock_held=
}
lock_stale() { # legacy or foreign owner records are reclaimed by age, never by a local pid
	local pid host namespace
	IFS=$'\t' read -r pid host namespace 2>/dev/null <"$1/pid" || true
	{ [[ ${pid:-} =~ ^[0-9]+$ ]] && [ "${host:-}" = "$LOCK_HOST" ] &&
		[ "${namespace:-}" = "$LOCK_NS" ] && ! kill -0 "$pid" 2>/dev/null; } ||
		{ [ ! -e "$1/pid" ] && [ -n "$(find "$1" -prune -mmin +1 2>/dev/null)" ]; } ||
		[ -n "$(find "$1" -prune -mmin +2 2>/dev/null)" ]
}
guard_stale() { lock_stale "$1" || [ -n "$(find "$1" -prune -mmin +1 2>/dev/null)" ]; }
reap_claim_lock() {
	local lock=$STATE_DIR/claim.lock guard=$STATE_DIR/claim.reap stale owner moved old
	reap_lock_held=1
	if ! mkdir "$guard" 2>/dev/null; then
		reap_lock_held=
		if guard_stale "$guard"; then
			owner=$(cat "$guard/pid" 2>/dev/null) || owner=
			stale=$STATE_DIR/claim.stale.reap.$$.$RANDOM
			if mv "$guard" "$stale" 2>/dev/null; then
				moved=$(cat "$stale/pid" 2>/dev/null) || moved=
				if [ "$moved" = "$owner" ] && guard_stale "$stale"; then
					rm -rf "$stale" 2>/dev/null || true
				elif [ ! -e "$guard" ] && [ ! -L "$guard" ]; then
					mv "$stale" "$guard" 2>/dev/null || true
				fi
			fi
		fi
		return 0
	fi
	if ! { printf '%s\n' "$LOCK_OWNER" >"$guard/pid"; } 2>/dev/null; then
		rmdir "$guard" 2>/dev/null || true
		reap_lock_held=
		return 0
	fi
	if [ -L "$lock" ] || { [ -e "$lock" ] && [ ! -d "$lock" ]; }; then
		rm -f "$lock" 2>/dev/null || true
	elif [ -d "$lock" ] && lock_stale "$lock"; then
		owner=$(cat "$lock/pid" 2>/dev/null) || owner=
		stale=$STATE_DIR/claim.stale.$$.$RANDOM
		if mv "$lock" "$stale" 2>/dev/null; then
			moved=$(cat "$stale/pid" 2>/dev/null) || moved=
			if [ "$moved" = "$owner" ] && lock_stale "$stale"; then
				rm -rf "$stale" 2>/dev/null || true
			elif [ ! -e "$lock" ] && [ ! -L "$lock" ]; then
				mv "$stale" "$lock" 2>/dev/null || true
			fi
		fi
	fi
	for old in "$STATE_DIR"/claim.stale.*; do
		if [ -n "$(find "$old" -prune -mmin +2 2>/dev/null)" ] && lock_stale "$old"; then
			rm -rf "$old" 2>/dev/null || true
		fi
	done
	# Acquirers take the guard too, so restoring a moved owner cannot nest into a new lock.
	if [ "${1:-}" = acquire ] && [ "$(cat "$guard/pid" 2>/dev/null)" = "$LOCK_OWNER" ]; then
		claim_lock_kind='mkdir'
		if ! mkdir "$lock" 2>/dev/null; then
			claim_lock_kind=
		elif { printf '%s\n' "$LOCK_OWNER" >"$lock/pid"; } 2>/dev/null; then
			if [ "$(cat "$guard/pid" 2>/dev/null)" != "$LOCK_OWNER" ] ||
				[ "$(cat "$lock/pid" 2>/dev/null)" != "$LOCK_OWNER" ]; then claim_unlock; fi
		else
			# A reaper may have moved it before the owner write; remove only an empty dir.
			rmdir "$lock" 2>/dev/null || true
			claim_lock_kind=
		fi
	fi
	reap_unlock
}

claim_lock() { # main shell only; the guard covers filesystem changes, never API calls
	local wait_secs=${IBX_TEST_CLAIM_LOCK_SECS:-300} end message # tests shorten it
	[ -z "$claim_lock_disabled" ] || return 0
	if ! state_dir_ok; then
		warn "could not use the local claim lock in ${STATE_DIR:-an unknown state directory}; continuing with settle checks"
		claim_lock_disabled=1
		return 0
	fi
	[[ $wait_secs =~ ^[0-9]+$ ]] || die "IBX_TEST_CLAIM_LOCK_SECS must be a non-negative integer"
	end=$((SECONDS + 10#$wait_secs))
	while [ "$SECONDS" -lt "$end" ]; do
		reap_claim_lock acquire
		[ "$claim_lock_kind" != mkdir ] || return 0
		sleep_for 0.1 || true
	done
	message='another ibx claim on this computer held the claim lock for 5 minutes; try again'
	stderr printf 'ibx: %s\n' "$message"
	json_error lock_busy "$message"
	exit 75
}

held_claims() { # machines-json [agent] [excluded-token]: holders, excluding invalid dates when counting an agent
	jq -c --arg by "${2:-}" --arg token "${3:-}" --argjson now "$(date +%s)" --argjson stale "$STALE_SECS" "$JQ_DEFS"'
		[.[] | select(inpool) | age($now) as $age |
		select($age != null and ($age == "invalid" or $age <= $stale)) |
		select($by == "" or $age != "invalid") |
		select($by == "" or .metadata["ibx.claim.by"] == $by) |
		select($token == "" or .metadata["ibx.claim.token"] != $token) |
		{name:(.name | clean), by:(.metadata["ibx.claim.by"] | clean),
		 since:(.metadata["ibx.claim.at"] | clean), purpose:(.metadata["ibx.claim.purpose"] | clean)}]' <<<"$1"
}
claim_limit() {
	local held count message
	[ "$MAX_CLAIMS" != 0 ] || return 0
	held=$(held_claims "$1" "$AGENT" "${2:-}")
	count=$(jq length <<<"$held")
	if jq -en --argjson n "$count" --argjson cap "$MAX_CLAIMS" '$n >= $cap' >/dev/null; then
		message="$AGENT already holds $count sandboxes ($(jq -r 'map(.name) | join(", ")' <<<"$held")), the most IBX_MAX_CLAIMS allows. Release one you no longer use, or ask the user."
		stderr printf 'ibx: %s\n' "$message"
		json_error claim_limit "$message" "$held"
		exit 75
	fi
}

stream_exec() { # id timeout: stdout/stderr pass through; only pre-start JSON refusals may retry
	local id=$1 timeout=$2 line headers=1 status=000 streamed='' event='' payload exit_seen='' rc=0
	rm -f "$tmp/sse"
	mkfifo "$tmp/sse" || die "could not open the exec stream"
	: >"$tmp/sse-body"
	curl -q -g -N -sS -i --suppress-connect-headers -m "$((timeout + 90))" -X POST -H @- \
		-H 'Content-Type: application/json' -H 'Accept: text/event-stream' \
		--data-binary @"$tmp/exec" "$API/v1/machines/$id/exec" \
		< <(printf '%s\n' "$AUTH") >"$tmp/sse" 2>"$tmp/err" &
	curl_pid=$!
	while IFS= read -r line || [ -n "$line" ]; do
		line=${line%$'\r'}
		if [ -n "$headers" ]; then
			case $line in
			HTTP/*) read -r _ status _ <<<"$line"; streamed= ;;
			'') case $status in 1??) ;; *) headers= ;; esac ;;
			*) case ${line,,} in content-type:*text/event-stream*) streamed=1 ;; esac ;;
			esac
			continue
		fi
		if [ -z "$streamed" ]; then printf '%s\n' "$line" >>"$tmp/sse-body"; continue; fi
		case $line in
		event:*) event=${line#event:}; event=${event# } ;;
		data:*)
			payload=${line#data:}
			case $event in
			stdout | stderr)
				jq -e '.data | type == "string"' <<<"$payload" >/dev/null || die "invalid exec stream output"
				if [ "$event" = stdout ]; then jq -j .data <<<"$payload" || die "could not write exec output"
				else stderr jq -j .data <<<"$payload"; fi ;;
			exit)
				jq -e '.exitCode | type == "number" and . == floor and . >= 0 and . <= 255' <<<"$payload" >/dev/null || die "invalid exec stream exit"
				R=$(jq -c '.stdout = "" | .stderr = ""' <<<"$payload") || die "invalid exec stream result"
				exit_seen=1 ;;
			error) die "exec stream failed after starting; the command was killed and may have run partly; check before retrying: $(jq -r "$JQ_DEFS"' .error.message // "stream error" | clean' <<<"$payload")" ;;
			esac ;;
		'') event= ;;
		esac
	done <"$tmp/sse"
	wait "$curl_pid" || rc=$?
	curl_pid=
	if [ -n "$streamed" ]; then
		[ "$rc" = 0 ] && [ -n "$exit_seen" ] || die "exec stream closed without a complete result; the command was killed and may have run partly; check before retrying"
		return 0
	fi
	# Only a 4xx error envelope establishes that the command did not run. Every 503 is
	# ambiguous: host_unavailable also covers an API restart that kills a running command.
	if [[ $status == 4[0-9][0-9] ]] && jq -e '.error.code | type == "string"' "$tmp/sse-body" >/dev/null 2>&1; then
		exec_phase=not_started
	fi
	cp "$tmp/sse-body" "$tmp/err"
	[ "$exec_phase" != not_started ] || api_refusal "$status" "$tmp/err"
	case $status in
	2??) if [ "$rc" = 0 ] && jq -e 'has("exitCode")' "$tmp/sse-body" >/dev/null; then R=$(cat "$tmp/sse-body"); return 0; fi ;;
	esac
	return 1
}

exec_in() { # id timeout cmd [stdin-file]: sets R to the ExecResult json. Call it directly, not
	# in $(...): then a SIGTERM while it waits for a slot ends ibx before it tries again.
	local id=$1 t=$2 code starts=0 end=$((SECONDS + 600)) m safe=${EXEC_SAFE:-}

	if [ $# -ge 4 ]; then
		jq -n --arg c "$3" --argjson t "$t" --rawfile s "$4" '{cmd:$c, timeoutSeconds:$t, stdin:$s}' >"$tmp/exec"
	else
		jq -n --arg c "$3" --argjson t "$t" '{cmd:$c, timeoutSeconds:$t}' >"$tmp/exec"
	fi
	while :; do
		exec_phase=partial
		if [ -n "${STREAM:-}" ]; then
			if stream_exec "$id" "$t"; then exec_phase=yes; return 0; fi
		elif IBX_EXEC_MAXTIME=$((t + 90)) api POST "/v1/machines/$id/exec" "$tmp/exec" >"$tmp/exec-result" 2>"$tmp/err"; then
			R=$(cat "$tmp/exec-result")
			exec_phase=yes
			return 0
		fi
		if [ -n "$STREAM" ] && [ "$exec_phase" != not_started ]; then
			stderr cat "$tmp/err"
			die "exec failed (the command may or may not have run; check before retrying)"
		fi
		code=$(err_code "$tmp/err")
		# These refusals come before the command starts: an interrupt from here on says so.
		case $code in quota_exceeded | machine_not_running | machine_cooldown | max_run_disabled | bad_request | not_found | permission_denied | bad_path) exec_phase=not_started ;; esac
		if auth_code "$code" || [ -s "$tmp/fatal" ]; then exec_phase=not_started; fi
		fatal_check
		case "$code" in
		quota_exceeded) # a refusal means the command did not run
			[ $SECONDS -lt $end ] || { stderr cat "$tmp/err"; die "exec did not run: the account's concurrent-request limit stayed full for 10 minutes"; }
			sleep_for "$((5 + RANDOM % 5))" ;;
		machine_not_running) # it never started, so retrying is safe
			starts=$((starts + 1))
			[ $starts -le 3 ] || { stderr cat "$tmp/err"; die "exec did not run: ${LABEL:-the sandbox} keeps stopping"; }
			ensure_running "$id" || die "exec did not run: could not start ${LABEL:-the sandbox}" ;;
		machine_cooldown)
			m=$(api GET "/v1/machines/$id") || die "could not read the cooldown"
			cooldown_wait "$tmp/err" "$m" "$end" || die "exec did not run: ${LABEL:-sandbox} is in its max-run cooldown"
			;;
		max_run_disabled) die "exec did not run: max-run is disabled for ${LABEL:-sandbox}" ;;
		bad_request | unauthenticated | api_key_expired | api_key_revoked | permission_denied | insufficient_scope | not_found | bad_path)
			stderr cat "$tmp/err"; die "exec rejected (the command did not run)" ;;
		host_unavailable)
			[ -n "$safe" ] || die "exec was cut off (the API server restarted; the command may have run partly and was killed; check before retrying)"
			if [ "$(jq -r '.error.retryable // false' <"$tmp/err")" = true ] && [ $SECONDS -lt $end ]; then sleep_for 5; continue; fi
			stderr cat "$tmp/err"; die "exec failed (the command may or may not have run; check before retrying)" ;;
		*)
			stderr cat "$tmp/err"
			if [ -n "$STREAM" ] && [ "$exec_phase" = not_started ]; then die "exec did not run: the API refused it before the stream started"; fi
			die "exec failed (the command may or may not have run; check before retrying)" ;;
		esac
	done
}

remote_cmd() { # args -> one bash command line: a single argument is a script, several are quoted
	if [ $# -eq 1 ]; then printf '%s' "$1"; else printf '%q ' "$@"; fi
}

file_api() { # METHOD id remote-path local-file: raw bytes, bounded storage, repeat-safe requests
	local method=$1 id=$2 remote=$3 local_file=$4 query code rc end=$((SECONDS + 600)) m starts=0
	# curl reads -T - (and -T .) as stdin, which here carries the key header, and expands {a,b} and
	# [1-9] in -T and URLs unless -g: only ever pass it a ./ or absolute path, with globbing off.
	# /dev/stdin and /dev/fd/N alias curl's own stdin and fds too: put passes a physical path.
	case $local_file in /*) ;; *) local_file=./$local_file ;; esac
	query=$(jq -rn --arg p "$remote" '$p | @uri')
	local args=(-q -g -sS -m 7200 -H @-)
	if [ "$method" = PUT ]; then
		args+=(-T "$local_file" -H 'Content-Type: application/octet-stream' -o "$tmp/file-body")
		query="/v1/machines/$id/files?path=$query&parents=true"
	else
		local cap=${IBX_GET_MAX:-2G} bytes
		[[ $cap =~ ^[0-9]+[kKmMgG]?$ ]] || die "IBX_GET_MAX must be bytes or an integer with K, M or G"
		bytes=$(jq -nr --arg c "$cap" '$c | capture("^(?<n>[0-9]+)(?<u>[kKmMgG]?)$") | (.n | tonumber) * ({"":1,k:1024,m:1048576,g:1073741824}[.u | ascii_downcase])')
		[ "$bytes" != 0 ] || die "IBX_GET_MAX must be greater than zero"
		args+=(--max-filesize "$bytes" -o "$local_file")
		query="/v1/machines/$id/files/content?path=$query"
	fi
	while :; do
		rc=0
		file_transfer=$method
		curl "${args[@]}" -D "$tmp/file-headers" -w '%{http_code}' "$API$query" \
			< <(printf '%s\n' "$AUTH") >"$tmp/file-status" &
		curl_pid=$!
		wait "$curl_pid" || rc=$?
		curl_pid=
		code=$(cat "$tmp/file-status")
		if [[ $code != 2* ]]; then
			[ "$method" != GET ] || cp "$local_file" "$tmp/file-body"
			api_refusal "$code" "$tmp/file-body"
			fatal_check
		fi
		if [ "$rc" != 0 ]; then
			if [ "$method" = PUT ]; then die "file upload failed (curl exit $rc); the remote file may have been replaced; check before retrying"; fi
			die "file download failed (curl exit $rc); destination was not replaced"
		fi
		case $code in 2??) return 0 ;; esac
		if [ "$code" = 404 ] && jq -e '.error.code == "not_found" and (.error.message | test("route.*not.*found|unknown route"; "i"))' "$tmp/file-body" >/dev/null; then file_transfer=; return 2; fi
		# These refusals come before any byte is written: an interrupt while waiting them out
		# says that nothing started.
		case $(err_code "$tmp/file-body") in quota_exceeded | machine_not_running | machine_cooldown) file_transfer= ;; esac
		case $(err_code "$tmp/file-body") in
		host_unavailable)
			jq -e '.error.retryable == true' "$tmp/file-body" >/dev/null && [ "$SECONDS" -lt "$end" ] || die "file transfer interrupted"
			sleep_for 5 ;;
		quota_exceeded)
			[ "$SECONDS" -lt "$end" ] || die "file transfer did not run: concurrent-request limit stayed full"
			sleep_for 5 ;;
		machine_not_running)
			starts=$((starts + 1))
			[ "$starts" -le 3 ] && [ "$SECONDS" -lt "$end" ] || die "file transfer did not run: $LABEL keeps stopping"
			ensure_running "$id" || die "could not start $LABEL for file transfer" ;;
		machine_cooldown)
			m=$(api GET "/v1/machines/$id") || die "could not read cooldown"
			cooldown_wait "$tmp/file-body" "$m" "$end" || die "file transfer did not run: max-run cooldown" ;;
		not_a_file) return 3 ;;
		no_space) die "file transfer failed: disk full" ;;
		too_large) die "file transfer failed: server limit is 5 GiB" ;;
		*) die "file transfer failed: $(jq -r '.error.message // "API error"' "$tmp/file-body" | printable)" ;;
		esac
	done
}
file_sha() {
	if command -v sha256sum >/dev/null; then sha256sum <"$1" | cut -d' ' -f1
	else shasum -a 256 <"$1" | cut -d' ' -f1; fi
}

public_ports() { # id -> "port US name US url" lines (US = \x1f keeps empty fields)
	local r
	r=$(api GET "/v1/machines/$1/ports") || return 1
	jq -r "$JQ_DEFS"' .ports[]? | select(.port | type == "number") | [(.port|tostring), (.name // "" | clean), (.url | clean), (.createdAt // "")] | join("\u001f")' <<<"$r"
}

unpublish() { # id port: also fine when it is already gone (a retried DELETE gets 404)
	api DELETE "/v1/machines/$1/ports/$2" >/dev/null 2>"$tmp/perr" || [ "$(err_code "$tmp/perr")" = not_found ]
}

phys() { # path -> the physical path of the file it names, symlinks followed (no realpath on old macOS)
	local p=$1 l n=0
	while [ -L "$p" ] && [ $n -lt 40 ]; do
		l=$(readlink -- "$p")
		case "$l" in /*) p=$l ;; *) p=$(dirname -- "$p")/$l ;; esac
		n=$((n + 1))
	done
	printf '%s/%s' "$(cd -P -- "$(dirname -- "$p")" && pwd -P)" "$(basename -- "$p")"
}

looks_secret() { # path -> 0 when the file looks like a credential
	local p=$1 b
	b=$(basename -- "$p" | tr '[:upper:]' '[:lower:]')
	case "$b" in
	.env | .env.* | *.env | *.pem | *.key | *.p12 | *.pfx | *.jks | *.kdbx | *.keystore | *.tfstate | *.tfvars | \
		id_rsa* | id_dsa* | id_ecdsa* | id_ed25519* | .netrc | .npmrc | .pypirc | .pgpass | .git-credentials | \
		credentials* | *secret* | *token* | api-key | *.ovpn) return 0 ;;
	esac
	case "/$p" in */.ssh/* | */.aws/* | */.gnupg/* | */.kube/* | */.docker/config.json | */gcloud/* | */.claude/* | */.codex/* | */instabox/*) return 0 ;; esac
	return 1
}

table() { if command -v column >/dev/null; then column -t -s $'\t'; else cat; fi; }

hold_class() { # machine-json -> owned, foreign, open, or bad
	# An unreadable date is still a live hold: owned for this agent, foreign for anyone else.
	jq -r --arg by "$AGENT" --argjson now "$(date +%s)" --argjson stale "$STALE_SECS" "$JQ_DEFS"'
		if .metadata != null and (.metadata | type) != "object" then "bad"
		else age($now) as $age |
			if .metadata["ibx.claim.by"] == $by and $age != null and ($age == "invalid" or $age <= $stale) then "owned"
			elif .metadata["ibx.claim.by"] != $by and (free($now; $stale) | not) then "foreign"
			else "open" end
		end' <<<"$1"
}

refuse_foreign() { # machine-json box
	local message held ms
	ms=$(all_machines) || die "could not list sandboxes"
	held=$(held_claims "$ms" "$AGENT")
	message=$(jq -r "$JQ_DEFS"' "\(.name | clean) is held by \(.metadata["ibx.claim.by"] // "?" | clean) since \(.metadata["ibx.claim.at"] | clean): \(.metadata["ibx.claim.purpose"] // "" | clean)"' <<<"$1")
	message+="; you hold: $(jq -r 'if length == 0 then "none" else map(.name) | join(", ") end' <<<"$held")"
	json_error held_by_other "$message" "$held"
	die "$message"
}

# The list check in resolve can be stale by the time release or renew writes. Re-apply it to the
# machine just fetched, before any port delete or metadata write. A change after this read can
# still win: the API has no compare-and-swap.
fresh_holder() { # machine-json box
	local kind message
	[ "${IBX_ALLOW_ANY:-}" = 1 ] && return 0
	kind=$(hold_class "$1") || die "could not read the reservation of $2"
	case $COMMAND in
	renew)
		case $kind in
		owned) return 0 ;;
		foreign) refuse_foreign "$1" "$2" ;;
		bad) die "could not read the reservation of $2" ;;
		*)
			message="$2 is not reserved by you; ibx claim first (no live reservation to renew)"
			json_error not_held "$message"
			die "$message" ;;
		esac ;;
	release)
		case $kind in
		foreign) refuse_foreign "$1" "$2" ;;
		bad) die "could not read the reservation of $2" ;;
		esac ;;
	esac
}

release_box() { # box: shared by literal and bulk release
	id=$(resolve --pool "$1")
	m=$(api GET "/v1/machines/$id") || die "could not read $1"
	fresh_holder "$m" "$1"
	ports=$(public_ports "$id") || die "could not list the public ports of $1; nothing released, try again"
	left='' unpublished='[]' left_alone='[]' reasons='[]'
	start=$(jq -r '.metadata["ibx.claim.start"] // empty' <<<"$m")
	while IFS=$'\037' read -r port name url created; do
		[[ $port =~ ^[0-9]+$ ]] || continue
		during=
		if jq -en --arg s "$start" --arg c "$created" "$JQ_DEFS"' ($s | timestamp) as $s | ($c | timestamp) as $c | $s != null and $c != null and $c >= $s' >/dev/null; then during=1; fi
		if [[ $name == ibx:* ]] || [ -n "$during" ]; then
			if unpublish "$id" "$port"; then
				unpublished=$(jq -c --argjson p "$port" '. + [$p]' <<<"$unpublished")
				reasons=$(jq -c --argjson p "$port" --arg why "$(if [ -n "$during" ]; then echo 'created during the reservation'; else echo 'published by ibx'; fi)" '. + [{port:$p,reason:$why}]' <<<"$reasons")
				[ -n "$JSON" ] || echo "unpublished port $port of $1"
			else left+=" $url"; fi
		else
			left_alone=$(jq -c --argjson p "$port" --arg n "$name" --arg u "$url" '. + [{port:$p,name:$n,url:$u}]' <<<"$left_alone")
			warn "left port $port alone ($url): it was not published by ibx"
		fi
	done <<<"$ports"
	[ -z "$left" ] || die "these URLs are STILL PUBLIC:$left (nothing released; ibx unport $1 PORT, then release again)"
	if [ "$(jq -r '.state // ""' <<<"$m")" = running ]; then
		LABEL=$1
		sweep_jobs "$id" release
		[ -n "$RELEASE_NO_CHECK" ] || report_leftovers "$id" "$1" "$start"
	fi
	api DELETE "/v1/machines/$id/activity-leases/$LEASE" >/dev/null 2>&1 || true
	set_claim "$id" '{}' || die "could not clear the reservation of $1"
	if [ -n "$JSON" ]; then
		jq -c --argjson u "$unpublished" --argjson l "$left_alone" --argjson reasons "$reasons" "$JQ_DEFS"'
			{name:(.name | clean),id:(.id | clean),unpublished:$u,unpublishReasons:$reasons,leftAlone:$l,
			was:(if (.metadata["ibx.claim.token"] // "") == "" then null else
				{by:(.metadata["ibx.claim.by"] | clean),since:(.metadata["ibx.claim.at"] | clean),
				purpose:(.metadata["ibx.claim.purpose"] | clean)} end)}' <<<"$m" >"$tmp/result"
	else
		echo "released $1 (was: $(jq -r "$JQ_DEFS"' "\(.metadata["ibx.claim.purpose"] // "no reservation" | clean) (\(.metadata["ibx.claim.by"] // "-" | clean), since \(.metadata["ibx.claim.at"] // "-" | clean))"' <<<"$m"))"
	fi
}

exec_shot() { # id timeout cmd [stdin-file]: one exec, no retry. Sets R. Does not die.
	local id=$1 t=$2
	if [ $# -ge 4 ]; then
		jq -n --arg c "$3" --argjson t "$t" --rawfile s "$4" '{cmd:$c, timeoutSeconds:$t, stdin:$s}' >"$tmp/exec"
	else
		jq -n --arg c "$3" --argjson t "$t" '{cmd:$c, timeoutSeconds:$t}' >"$tmp/exec"
	fi
	exec_phase=partial
	if IBX_EXEC_MAXTIME=$((t + 30)) api POST "/v1/machines/$id/exec" "$tmp/exec" >"$tmp/exec-result" 2>"$tmp/err"; then
		R=$(cat "$tmp/exec-result")
		exec_phase=yes
		return 0
	fi
	return 1
}

home_has() { # id absolute-path -> 0 when the file API does not answer 404
	local code path
	path=$(jq -rn --arg p "$2" '$p | @uri')
	code=$(printf '%s\n' "$AUTH" | curl -q -g -sS -m 20 -o "$tmp/probe-body" -w '%{http_code}' -H @- \
		"$API/v1/machines/$1/files/content?path=$path") || return 1
	[ "$code" != 404 ]
}

lexnorm() { # lexical absolute path; the target need not exist
	local IFS=/ x
	local -a parts=()
	for x in ${1#/}; do
		case $x in
		'' | .) ;;
		..) [ "${#parts[@]}" -eq 0 ] || unset 'parts[${#parts[@]}-1]' ;;
		*) parts+=("$x") ;;
		esac
	done
	if [ "${#parts[@]}" -eq 0 ]; then printf '/\n'; else printf '/%s\n' "$(IFS=/; printf '%s' "${parts[*]}")"; fi
}

link_escapes() { # root relative-path -> 0 when a symlink resolves outside root
	local root=$1 rel=$2 dest base norm
	[ -L "$root/$rel" ] || return 1
	dest=$(readlink -- "$root/$rel") || return 0
	case $dest in
	/*) ;;
	*) dest=$(dirname -- "$root/$rel")/$dest ;;
	esac
	base=$(cd -- "$root" && pwd -P)
	norm=$(lexnorm "$dest")
	case "$norm/" in
	"$base"/*) return 1 ;;
	*) return 0 ;;
	esac
}

job_name_ok() { [[ $1 =~ ^[a-z0-9][a-z0-9._-]{0,39}$ ]]; }

job_controller() { # name replace token. The script's stdin is the user command.
	cat <<EOF
#!/bin/bash
# ibx-remote
set -u
name=$(printf %q "$1")
replace=$(printf %q "$2")
token=$(printf %q "$3")
root="\$HOME/.ibx/jobs/\$name"
mkdir -p -- "\$HOME/.ibx/jobs"
cmdfile=\$(mktemp "\$HOME/.ibx/jobs/.cmd.XXXXXX")
cat >"\$cmdfile"
boot=\$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || printf '%s\n' noboot)
if [ -d "\$root" ] && [ -s "\$root/pid" ] && [ ! -f "\$root/rc" ]; then
	pid=\$(cat "\$root/pid")
	old=\$(cat "\$root/boot" 2>/dev/null || printf '%s\n' missing)
	if [ "\$old" = "\$boot" ] && kill -0 "\$pid" 2>/dev/null; then
		printf '%s\n' "job \$name is already running" >&2
		rm -f -- "\$cmdfile"
		exit 3
	fi
fi
if [ -f "\$root/rc" ] && [ "\$replace" != 1 ]; then
	printf '%s\n' "job \$name already finished; pass --replace to run it again" >&2
	rm -f -- "\$cmdfile"
	exit 3
fi
rm -rf -- "\$root"
mkdir -p -- "\$root"
mv -- "\$cmdfile" "\$root/cmd"
chmod 700 "\$root/cmd"
date -u +%Y-%m-%dT%H:%M:%SZ >"\$root/started"
printf '%s\n' "\$token" >"\$root/token"
printf '%s\n' "\$boot" >"\$root/boot"
: >"\$root/log"
cat >"\$root/runner" <<'RUN'
#!/bin/bash
echo \$\$ >"\$1"
rc=0
bash "\$2" </dev/null >"\$3" 2>&1 || rc=\$?
printf '%s\n' "\$rc" >"\$4.part"
mv -f "\$4.part" "\$4"
RUN
chmod 700 "\$root/runner"
# Debian has setsid. The mock runs this script on the CI machine; macOS does not
# ship setsid, so python calls setsid(2) and the job is still a new session.
if command -v setsid >/dev/null; then
	setsid -f "\$root/runner" "\$root/pid" "\$root/cmd" "\$root/log" "\$root/rc" </dev/null >/dev/null 2>&1 || {
		printf '%s\n' "could not start job \$name" >&2
		exit 4
	}
elif command -v python3 >/dev/null; then
	python3 -c 'import os, sys
pid = os.fork()
if pid > 0:
    os._exit(0)
os.setsid()
os.execv(sys.argv[1], sys.argv[1:])' "\$root/runner" "\$root/pid" "\$root/cmd" "\$root/log" "\$root/rc" </dev/null >/dev/null 2>&1 || {
		printf '%s\n' "could not start job \$name" >&2
		exit 4
	}
else
	printf '%s\n' "setsid is not installed on the sandbox" >&2
	exit 4
fi
i=0
while [ "\$i" -lt 50 ]; do
	[ -s "\$root/pid" ] && break
	i=\$((i + 1))
	sleep 0.05
done
[ -s "\$root/pid" ] || { printf '%s\n' "job \$name produced no process id" >&2; exit 4; }
printf 'started %s pgid %s\n' "\$name" "\$(cat "\$root/pid")"
EOF
}

job_remote() { # mode [arg] [arg]
	cat <<EOF
#!/bin/bash
# ibx-remote
set -u
mode=$(printf %q "$1")
arg1=$(printf %q "${2:-}")
arg2=$(printf %q "${3:-}")
boot_now=\$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || printf '%s\n' noboot)
job_state() {
	local d=\$1 pid old
	if [ -f "\$d/killed" ]; then printf '%s\n' killed; return; fi
	if [ -f "\$d/rc" ]; then printf '%s\n' exited; return; fi
	pid=\$(cat "\$d/pid" 2>/dev/null || true)
	old=\$(cat "\$d/boot" 2>/dev/null || printf '%s\n' missing)
	if [ -n "\$pid" ] && [ "\$old" = "\$boot_now" ] && kill -0 "\$pid" 2>/dev/null; then printf '%s\n' running; return; fi
	printf '%s\n' lost
}
job_line() {
	local d=\$1 name st rc started elapsed= now s
	name=\$(basename -- "\$d")
	st=\$(job_state "\$d")
	rc=\$(cat "\$d/rc" 2>/dev/null || true)
	started=\$(cat "\$d/started" 2>/dev/null || true)
	if [ -n "\$started" ]; then
		s=\$(date -u -d "\$started" +%s 2>/dev/null || true)
		now=\$(date -u +%s)
		if [ -n "\$s" ]; then elapsed=\$((now - s)); fi
	fi
	printf '%s\t%s\t%s\t%s\t%s\n' "\$name" "\$st" "\$rc" "\$started" "\$elapsed"
}
stop_pid() {
	local pid=\$1 i=0
	[ -n "\$pid" ] || return 0
	kill -TERM -- -"\$pid" 2>/dev/null || kill -TERM "\$pid" 2>/dev/null || true
	while [ "\$i" -lt 10 ] && kill -0 "\$pid" 2>/dev/null; do sleep 1; i=\$((i + 1)); done
	if kill -0 "\$pid" 2>/dev/null; then kill -KILL -- -"\$pid" 2>/dev/null || kill -KILL "\$pid" 2>/dev/null || true; fi
}
shopt -s nullglob
case "\$mode" in
list)
	for d in "\$HOME"/.ibx/jobs/*/; do [ -d "\$d" ] && job_line "\$d"; done ;;
status)
	d="\$HOME/.ibx/jobs/\$arg1"
	if [ -d "\$d" ] && { [ -s "\$d/pid" ] || [ -f "\$d/rc" ]; }; then
		pid=\$(cat "\$d/pid" 2>/dev/null || printf '%s\n' 0)
		printf 'started %s pgid %s\n' "\$arg1" "\$pid"
	else printf '%s\n' absent; fi ;;
show)
	d="\$HOME/.ibx/jobs/\$arg1"
	[ -d "\$d" ] || { printf '%s\n' "no job \$arg1" >&2; exit 3; }
	job_line "\$d"
	if [ -n "\$arg2" ] && [ -f "\$d/log" ]; then printf '\n'; tail -n "\$arg2" "\$d/log"; fi ;;
wait)
	d="\$HOME/.ibx/jobs/\$arg1"
	[ -d "\$d" ] || { printf '%s\n' "no job \$arg1" >&2; exit 3; }
	end=\$((SECONDS + arg2))
	while [ "\$SECONDS" -lt "\$end" ]; do
		[ "\$(job_state "\$d")" = running ] || break
		sleep 1
	done
	job_line "\$d" ;;
kill)
	d="\$HOME/.ibx/jobs/\$arg1"
	[ -d "\$d" ] || { printf '%s\n' "no job \$arg1" >&2; exit 3; }
	stop_pid "\$(cat "\$d/pid" 2>/dev/null || true)"
	: >"\$d/killed"
	printf '%s\n' 143 >"\$d/rc"
	job_line "\$d" ;;
sweep)
	for d in "\$HOME"/.ibx/jobs/*/; do
		[ -d "\$d" ] || continue
		if [ "\$(job_state "\$d")" = running ]; then
			stop_pid "\$(cat "\$d/pid" 2>/dev/null || true)"
			printf 'killed job %s\n' "\$(basename -- "\$d")"
		fi
	done
	rm -rf -- "\$HOME/.ibx" ;;
claim)
	for d in "\$HOME"/.ibx/jobs/*/; do
		[ -d "\$d" ] || continue
		t=\$(cat "\$d/token" 2>/dev/null || true)
		[ "\$t" = "\$arg1" ] && continue
		[ "\$(job_state "\$d")" = running ] && stop_pid "\$(cat "\$d/pid" 2>/dev/null || true)"
		printf 'stopped leftover job %s\n' "\$(basename -- "\$d")"
	done
	rm -rf -- "\$HOME/.ibx" ;;
left)
	[ -d /proc ] || exit 0
	epoch=\$(date -u -d "\$arg1" +%s 2>/dev/null || true)
	if [ -z "\$epoch" ] && command -v python3 >/dev/null; then
		epoch=\$(python3 -c 'import datetime,sys; print(int(datetime.datetime.fromisoformat(sys.argv[1].replace("Z","+00:00")).timestamp()))' "\$arg1" 2>/dev/null || true)
	fi
	[ -n "\$epoch" ] || exit 0
	btime=\$(awk '/^btime /{print \$2}' /proc/stat)
	hz=\$(getconf CLK_TCK 2>/dev/null || echo 100)
	home=\$(cd -- "\$HOME" && pwd -P)
	for piddir in /proc/[0-9]*; do
		pid=\${piddir##*/}
		cwd=\$(readlink "\$piddir/cwd" 2>/dev/null || true)
		case "\$cwd/" in "\$home"/*) ;; *) continue ;; esac
		cmd=\$(tr '\0' ' ' <"\$piddir/cmdline" 2>/dev/null || true)
		case "\$cmd" in
		*sshd*|*Xvnc*|*xfce*|*xfwm*|*xfdesktop*|*xfsettings*|*instabox-guest-agent*|*instabox-port*|*dbus*|*pulseaudio*|*pipewire*|*systemd*|*gnome-keyring*|*ibx-remote*) continue ;;
		esac
		[ -n "\$cmd" ] || continue
		ticks=\$(awk '{print \$22}' "\$piddir/stat" 2>/dev/null || echo 0)
		born=\$((btime + ticks / hz))
		[ "\$born" -ge "\$epoch" ] || continue
		port=
		if command -v ss >/dev/null; then
			port=\$(ss -H -ltnp 2>/dev/null | awk -v p="\$pid" 'index(\$0, "pid=" p ",") {print \$4; exit}')
			port=\${port##*:}
		fi
		if [ -n "\$port" ]; then printf '%s (pid %s, :%s) still running; it was not stopped\n' "\$cmd" "\$pid" "\$port"
		else printf '%s (pid %s) still running; it was not stopped\n' "\$cmd" "\$pid"; fi
	done ;;
esac
EOF
}

warn_remote_lines() {
	local line
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		warn "$(printf '%s' "$line" | printable)"
	done <<<"$1"
}

sweep_jobs() { # id release|claim [token]
	local script text
	home_has "$1" /data/home/.ibx/jobs || return 0
	case $2 in
	release) script=$(job_remote sweep) ;;
	claim) script=$(job_remote claim "$3") ;;
	*) return 0 ;;
	esac
	if exec_shot "$1" 30 "$script"; then
		text=$(jq -r '.stdout // ""' <<<"$R")
		warn_remote_lines "$text"
	else
		fatal_check
		warn "could not sweep ibx jobs on ${LABEL:-$1}"
	fi
}

report_leftovers() { # id box claim-start   uses the machine object in m
	local script text
	[ -n "$3" ] || return 0
	[ "$(jq -r '.state // ""' <<<"$m")" = running ] || return 0
	script=$(job_remote left "$3")
	if exec_shot "$1" 15 "$script"; then
		text=$(jq -r '.stdout // ""' <<<"$R")
		warn_remote_lines "$text"
	else
		fatal_check
		warn "could not list processes left running on $2"
	fi
}

tail_wrapper() { # n command
	cat <<EOF
#!/bin/bash
# ibx-remote
n=$(printf %q "$1")
log="\$HOME/.ibx/out/\$(date +%s)-\$\$.log"
mkdir -p -- "\$(dirname -- "\$log")"
set +e
bash -c $(printf %q "$2") >"\$log" 2>&1
rc=\$?
set -e
lines=\$(wc -l <"\$log" | tr -d ' ')
tail -n "\$n" "\$log" >&2
printf '[ibx: full output %s, %s lines]\\n' "\$log" "\$lines" >&2
exit "\$rc"
EOF
}

put_tree() { # box src dst. untracked, excludes and force are in scope.
	local box=$1 src=$2 dst=$3 top='' here='' prefix='' rel n=0 secret secret_n=0 bytes sha id remote arch rand file_rc skip glob shell_dest shell_arch
	local -a secrets=()
	[ -z "$force" ] || die "--force applies to a single file, not a directory"
	src=$(cd -- "$src" && pwd -P)
	: >"$tmp/tree-raw"
	if top=$(git -C "$src" rev-parse --show-toplevel 2>/dev/null); then
		top=$(cd -- "$top" && pwd -P)
		here=$src
		case "$here/" in
		"$top"/* | "$top/") ;;
		*) top= ;;
		esac
	fi
	if [ -n "$top" ]; then
		prefix=
		[ "$here" = "$top" ] || prefix=${here#"$top"/}/
		git -C "$top" ls-files -z -- "${prefix:-.}" >"$tmp/tree-raw" || die "could not list tracked files in $src"
		if [ -n "$untracked" ]; then
			git -C "$top" ls-files -z -o --exclude-standard -- "${prefix:-.}" >>"$tmp/tree-raw" || die "could not list untracked files in $src"
		fi
	else
		(cd -- "$src" && find . \( -name .git -o -name node_modules \) -prune -o \( -type f -o -type l \) -print0) >"$tmp/tree-raw"
	fi
	: >"$tmp/tree-list"
	while IFS= read -r -d '' rel; do
		[ -n "$rel" ] || continue
		rel=${rel#./}
		rel=${rel#"$prefix"}
		[ -n "$rel" ] || continue
		skip=
		for glob in "${excludes[@]+"${excludes[@]}"}"; do
			# shellcheck disable=SC2254
			case $rel in $glob) skip=1 ;; esac
		done
		[ -z "$skip" ] || continue
		[ -e "$src/$rel" ] || [ -L "$src/$rel" ] || continue
		if link_escapes "$src" "$rel"; then die "refusing $rel: that symlink resolves outside $src"; fi
		if looks_secret "$rel" || looks_secret "$src/$rel"; then
			secret_n=$((secret_n + 1))
			[ "$secret_n" -gt 20 ] || secrets+=("$rel")
			continue
		fi
		printf '%s\0' "$rel" >>"$tmp/tree-list"
		n=$((n + 1))
	done <"$tmp/tree-raw"
	if [ "$secret_n" -gt 0 ]; then
		secret="refusing $src: $secret_n path(s) look like credentials"
		[ "$secret_n" -le 20 ] || secret="$secret (showing 20)"
		secret="$secret: ${secrets[*]}"
		json_error looks_secret "$secret"
		die "$secret"
	fi
	id=$(resolve --pool "$box")
	LABEL=$box
	if [ "$n" -eq 0 ]; then
		if [ -n "$JSON" ]; then jq -n '{files:0,bytes:0,sha256:null}' >"$tmp/result"; else echo "copied 0 files to $box:$dst"; fi
		exit 0
	fi
	tar -C "$src" --null -T "$tmp/tree-list" -czf "$tmp/tree.tgz" || die "could not archive $src"
	bytes=$(size_of "$tmp/tree.tgz")
	[ "$bytes" -le 5368709120 ] || die "directory archive exceeds the server limit of 5 GiB"
	sha=$(file_sha "$tmp/tree.tgz")
	rand=$(idem)
	case $dst in
	/*) remote=$dst ;;
	*) remote=/data/home/${dst#\~/} ;;
	esac
	arch=/data/home/.ibx/in/$rand.tgz
	file_rc=0
	file_api PUT "$id" "$arch" "$tmp/tree.tgz" || file_rc=$?
	[ "$file_rc" != 2 ] || die "this server has no file routes; directory copy needs them"
	[ "$file_rc" = 0 ] || die "could not upload $src"
	[ "$sha" = "$(jq -r .sha256 "$tmp/file-body")" ] || die "uploaded archive SHA-256 does not match"
	shell_dest=$(printf '$HOME/%q' "${dst#\~/}")
	shell_arch=$(printf '$HOME/.ibx/in/%s.tgz' "$rand")
	EXEC_SAFE=1 exec_in "$id" 120 "# ibx-remote
mkdir -p -- $shell_dest && tar xzf $shell_arch -C $shell_dest && rm -f -- $shell_arch"
	[ "$(jq -r .exitCode <<<"$R")" = 0 ] || die "could not extract on $box: $(jq -r .stderr <<<"$R" | printable)"
	if [ -n "$JSON" ]; then
		jq -n --argjson files "$n" --argjson bytes "$bytes" --arg sha "$sha" '{files:$files,bytes:$bytes,sha256:$sha}' >"$tmp/result"
	else
		echo "copied $n files ($bytes bytes) to $box:$dst"
	fi
	exit 0
}

inspect_tar() { # refuse names and types from the stored headers, before extract
	# tar -t is not the check: bsdtar can print a rewritten name (the .. dropped) and
	# exit 0, and the extract then succeeds. python3 reads the ustar, pax and GNU headers.
	local msg rc=0
	command -v python3 >/dev/null || die "could not inspect the archive: python3 is missing"
	# A here-document on python's stdin can be skipped by the shell, and python
	# then exits 0 without reading the archive. The copy would succeed.
	cat >"$tmp/inspect-tar.py" <<'IBX_TAR'
import gzip, sys

def fail(msg):
    print(msg)
    raise SystemExit(1)

def cstr(field):
    return field.split(b"\0", 1)[0].decode("utf-8", "surrogateescape")

def tar_number(field):
    if field[:1] and field[0] & 0x80:
        if field[0] == 0xff:
            return int.from_bytes(field, "big", signed=True)
        return int.from_bytes(bytes([field[0] & 0x7f]) + field[1:], "big")
    text = field.split(b"\0", 1)[0].strip()
    if not text:
        return 0
    try:
        return int(text, 8)
    except ValueError:
        fail("could not inspect the archive")

def checksum_ok(block):
    stored = block[148:156].split(b"\0", 1)[0].strip()
    try:
        want = int(stored or b"0", 8)
    except ValueError:
        return False
    return sum(block[:148]) + 32 * 8 + sum(block[156:]) == want

def header_name(block):
    name = cstr(block[0:100])
    if block[257:262] == b"ustar":
        prefix = cstr(block[345:500])
        if prefix:
            name = prefix + "/" + name
    return name

def parse_pax(data):
    out = {}
    i, n = 0, len(data)
    while i < n and data[i:i + 1] not in (b"\0", b""):
        sp = data.find(b" ", i)
        if sp <= i:
            fail("could not inspect the archive")
        try:
            length = int(data[i:sp])
        except ValueError:
            fail("could not inspect the archive")
        if length < 3 or i + length > n:
            fail("could not inspect the archive")
        rec = data[i:i + length]
        if not rec.endswith(b"\n"):
            fail("could not inspect the archive")
        body = rec[sp - i + 1:-1]
        key, sep, val = body.partition(b"=")
        if sep != b"=":
            fail("could not inspect the archive")
        out[key.decode("utf-8", "surrogateescape")] = val.decode("utf-8", "surrogateescape")
        i += length
    return out

def bad_name(name):
    return name == "" or "\0" in name or name.startswith("/") or ".." in name.split("/")

def read_exact(fh, n):
    buf = b""
    while len(buf) < n:
        chunk = fh.read(n - len(buf))
        if not chunk:
            return buf
        buf += chunk
    return buf

path = sys.argv[1]
pending = None
global_path = None
try:
    with gzip.open(path, "rb") as fh:
        while True:
            block = read_exact(fh, 512)
            if not block:
                break
            if len(block) != 512:
                fail("could not inspect the archive")
            if block == b"\0" * 512:
                break
            if not checksum_ok(block):
                fail("could not inspect the archive")
            size = tar_number(block[124:136])
            if size < 0:
                fail("could not inspect the archive")
            blocks = (size + 511) // 512
            payload = read_exact(fh, blocks * 512)
            if len(payload) != blocks * 512:
                fail("could not inspect the archive")
            payload = payload[:size]
            typ = block[156:157]
            if typ == b"L":
                pending = cstr(payload)
                continue
            if typ == b"K":
                continue
            if typ in (b"x", b"X"):
                rec = parse_pax(payload)
                if "path" in rec:
                    pending = rec["path"]
                continue
            if typ == b"g":
                rec = parse_pax(payload)
                if "path" in rec:
                    global_path = rec["path"]
                continue
            if pending is not None:
                name = pending
                pending = None
            elif global_path is not None:
                name = global_path
            else:
                name = header_name(block)
            if bad_name(name):
                fail("refusing archive entry " + name)
            if typ not in (b"0", b"\0", b"5"):
                fail("refusing an archive entry that is not a regular file or directory")
except SystemExit:
    raise
except Exception:
    fail("could not inspect the archive")
print("ok")
IBX_TAR
	msg=$(python3 "$tmp/inspect-tar.py" "$1") || rc=$?
	[ "$rc" = 0 ] && [ "$msg" = ok ] || die "${msg:-could not inspect the archive}"
}

get_tree() { # box remote-src local-dst
	local box=$1 src=$2 dst=$3 id rand arch stage rel shell_src shell_arch
	id=$(resolve --pool "$box")
	LABEL=$box
	ensure_running "$id" || die "could not start $box for file transfer"
	rel=${src%/}
	rel=${rel#\~/}
	if [ -e "$dst" ]; then
		if [ -d "$dst" ]; then
			[ -z "$(find "$dst" -mindepth 1 -print -quit)" ] || die "$dst is not empty"
		else
			die "$dst exists"
		fi
	fi
	rand=$(idem)
	case $rel in
	/*) shell_src=$(printf '%q' "$rel"); arch=$rel.ibx.tgz ;;
	*) shell_src=$(printf '$HOME/%q' "$rel"); arch=/data/home/.ibx/out/$rand.tgz ;;
	esac
	shell_arch=$(printf '$HOME/.ibx/out/%s.tgz' "$rand")
	EXEC_SAFE=1 exec_in "$id" 120 "# ibx-remote
mkdir -p -- \$HOME/.ibx/out && tar czf $shell_arch -C $shell_src ."
	[ "$(jq -r .exitCode <<<"$R")" = 0 ] || die "could not archive $box:$src: $(jq -r .stderr <<<"$R" | printable)"
	stage=$(mktemp "${TMPDIR:-/tmp}/ibx-get.XXXXXX") || die "could not stage download"
	remove_download() { rm -f "$stage"; }
	cleanup_fns+=(remove_download)
	file_api GET "$id" "$arch" "$stage" || die "could not download $box:$src"
	EXEC_SAFE=1 exec_shot "$id" 30 "# ibx-remote
rm -f -- $shell_arch" || warn "could not remove the temporary archive on $box"
	inspect_tar "$stage"
	rm -rf -- "${dst}.ibx-part"
	mkdir -p -- "${dst}.ibx-part" || die "could not stage $dst"
	if ! tar -xzf "$stage" -C "${dst}.ibx-part" --no-same-owner --no-same-permissions; then
		rm -rf -- "${dst}.ibx-part"
		die "could not extract $box:$src"
	fi
	if [ -d "$dst" ]; then rmdir -- "$dst" || die "could not replace $dst"; fi
	mv -- "${dst}.ibx-part" "$dst" || die "could not write $dst"
	if [ -n "$JSON" ]; then
		jq -n --arg src "$src" --arg dst "$dst" '{src:$src,dst:$dst}' >"$tmp/result"
	else
		echo "copied $box:$src -> $dst"
	fi
	exit 0
}
# shellcheck disable=SC2030 # private subshell state must survive function unwinding at EXIT
release_isolated() ( # status-file box: private result/error files; AUTH stays a shell variable
	set -e
	trap - INT TERM # a signal aimed at the parent must not kill this release halfway
	release_status_file=$1
	tmp=$(mktemp -d "${TMPDIR:-/tmp}/ibx.XXXXXX") || die "could not stage release"
	JSON=1 main_pid=$BASHPID
	trap cleanup EXIT
	exec {JSON_FD}>&1
	: >"$tmp/warnings"
	release_box "$2"
)

cmd=$1
shift
if [ "$cmd" = pool ] && [ "${1:-}" = ls ]; then cmd='ls'; shift; fi
# shellcheck disable=SC2031 # release_isolated deliberately leaves parent tmp/JSON unchanged
case "$cmd" in
ls)
	all='' json='' mine=''
	for a in "$@"; do case "$a" in --all) all=1 ;; --mine) mine=1 ;; --json) json=1 ;; *) die "usage: ibx ls [--all | --mine] [--json]" ;; esac; done
	[ -z "$mine" ] || [ -z "$all" ] || die "--mine and --all cannot be combined"
	ms=$(all_machines) || die "could not list sandboxes"
	secrets_rows='{}'
	while IFS= read -r id; do
		[[ $id =~ ^m_[a-z2-7]{26}$ ]] || continue
		secret=true
		IBX_ALLOW_SECRETS='' secrets_state "$id" && secret=false
		fatal_check
		secrets_rows=$(jq -c --arg id "$id" --argjson value "$secret" '. + {($id):$value}' <<<"$secrets_rows")
	done < <(jq -r '.[].id' <<<"$ms")
	rows=$(jq --argjson secrets "$secrets_rows" --argjson now "$(date +%s)" --argjson stale "$STALE_SECS" --arg all "$all" "$JQ_DEFS"'
		[.[] | select($all == "1" or inpool) | age($now) as $age | {
			name: (.name | clean), id, state, pool: inpool, vault: vaulton, secrets:$secrets[.id],
			pausesAt:pauses, cooldownUntil:(.cooldownUntil // null | clean), maxRunMinutes, runStartedAt, runtime:(.runtime // null),
			reservation: (if $age == null then "free"
				elif $age == "invalid" then "invalid"
				elif $age > $stale then "abandoned" else "held" end),
			by: (.metadata["ibx.claim.by"] | clean), since: (.metadata["ibx.claim.at"] | clean),
			purpose: (.metadata["ibx.claim.purpose"] | clean)}]' <<<"$ms")
	if [ -n "$mine" ]; then
		rows=$(jq --arg by "$AGENT" '[.[] | select(.pool and .reservation == "held" and .by == $by)]' <<<"$rows")
		[ -n "$json" ] || stderr printf 'you are %s (%s)\n' "$AGENT" "$AGENT_SOURCE"
		[ "$(jq length <<<"$rows")" != 0 ] || warn "you hold no sandboxes"
	fi
	if [ -n "$json" ] && [ -n "$mine" ]; then
		jq -n --arg agent "$AGENT" --arg source "$AGENT_SOURCE" --argjson boxes "$rows" '{agent:$agent,agentSource:$source,boxes:$boxes}'
	elif [ -n "$json" ]; then
		printf '%s\n' "$rows"
	elif [ "$(jq length <<<"$rows")" = 0 ] && [ -z "$mine" ]; then
		warn "the pool is empty. The user can add sandboxes with: ibx pool add <box> (ibx ls --all lists every sandbox)"
	else
		jq -r '.[] | [.name, .state, (if .reservation == "free" then "free"
			elif .reservation == "abandoned" then "free (abandoned reservation by \(.by // "?"))"
			elif .reservation == "invalid" then "held? reservation date unreadable (\(.since)); only the user should release it"
			else "held by \(.by // "?") since \(.since): \(.purpose // "")" end),
			(if .pool then "" else "not in pool" end), (.pausesAt // ""), (.cooldownUntil // "")] | @tsv' <<<"$rows" | table
	fi
	;;
pool)
	sub=${1:-}
	shift || true
	allow_vault='' boxes=()
	for a in "$@"; do
		case "$a" in
		--allow-vault) [ "$sub" = add ] || die "--allow-vault only goes with ibx pool add"; allow_vault=1 ;;
		-*) die "unknown option $a" ;;
		*) boxes+=("$a") ;;
		esac
	done
	set -- "${boxes[@]}"
	case "$sub" in
	add | rm)
		[ $# -ge 1 ] || die "usage: ibx pool $sub [--allow-vault] <box>..."
		for b in "$@"; do
			id=$(resolve "$b")
			if [ "$sub" = add ]; then
				m=$(api GET "/v1/machines/$id") || die "could not read $b"
				n=$(vault_items "$id" "$b") || die "could not read the Vault of $b"
				if [ "$n" != 0 ] && [ -z "$allow_vault" ]; then
					die "$b receives $n Vault secret(s) at every boot, and agents run untrusted code in pool sandboxes. Use a sandbox created with --no-vault, or ibx pool add --allow-vault $b to accept that"
				fi
				if [ "$(jq -r "$JQ_DEFS"' vaulton' <<<"$m")" = true ]; then
					warn "note: $b has the Vault on ($n item(s) now). Secrets you add to the Vault later reach it; a sandbox created with --no-vault is safer"
				fi
				secret_rc=0
				secrets_state "$id" || secret_rc=$?
				fatal_check
				[ "$secret_rc" != 2 ] || die "could not inspect the Org Secrets of $b; nothing changed, try again"
				[ "$secret_rc" = 0 ] || die "$b has Org Secrets selected, pending or left behind; clear both selections with PATCH /v1/machines/ID/secrets {\"secrets\":[],\"envSecrets\":[]}, or recreate with --no-vault --secrets none"
				set_meta "$id" '. + {"ibx.pool": "1"}' || die "could not add $b"
				echo "added $b to the pool"
			else
				set_meta "$id" 'del(.["ibx.pool"])' || die "could not remove $b"
				echo "removed $b from the pool"
			fi
		done
		;;
	*) die "usage: ibx pool add [--allow-vault] <box>... | ibx pool rm <box>... | ibx pool ls" ;;
	esac
	;;
claim)
	purpose=${1:-}
	[[ $purpose != -* ]] || die "unknown option $purpose; the purpose is one quoted argument"
	[ $# -eq 1 ] && [ -n "$purpose" ] || die 'usage: ibx claim [--json] "<purpose>": the purpose must be ONE quoted argument'
	purpose=$(printf '%s' "$purpose" | tr '\t\n\r' '   ' | printable)
	token=$(idem)
	apierr=''
	claimed_ids=()
	claim_lock_kind='' claim_lock_disabled=''
	cleanup_fns+=(claim_unlock reap_unlock)
	unclaim() { # clears every reservation this run wrote, unless someone else holds it now
		local i m
		for i in "${claimed_ids[@]}"; do
			[ -n "$i" ] || continue
			jq -e --arg id "$i" 'any(.[]?; .id == $id)' <<<"$kept_claim" >/dev/null && continue
			m=$(api GET "/v1/machines/$i") || continue
			[ "$(jq -r '.metadata["ibx.claim.token"] // ""' <<<"$m")" = "$token" ] && set_claim "$i" '{}'
		done
		return 0
	}
	cleanup_fns+=(unclaim)
	for attempt in 1 2; do
		ms=$(all_machines) || die "could not list sandboxes"
		[ "$(jq "$JQ_DEFS"' [.[] | select(inpool)] | length' <<<"$ms")" != 0 ] ||
			die "the pool is empty: ask the user to run  ibx pool add <box>"
		claim_limit "$ms" "$token"
		cands='[.[] | select(inpool) | select(free($now; $stale)) | select(available($now))'
		shuffled=$(jq -c '.[]' <<<"$ms" | shuffle | jq -sc .)
		running=$(jq -r --argjson now "$(date +%s)" --argjson stale "$STALE_SECS" "$JQ_DEFS $cands"' | select(.state == "running" )] | sort_by(-(((pauses | timestamp) // 1e15) - $now | floor / 3600 | floor)) | .[].id' <<<"$shuffled")
		others=$(jq -r --argjson now "$(date +%s)" --argjson stale "$STALE_SECS" "$JQ_DEFS $cands"' |
			select(.state | IN("suspended","stopped","starting","resuming","suspending","stopping"))] | .[].id' <<<"$ms" | shuffle)
		for id in $running $others; do
			[[ $id =~ ^m_[a-z2-7]{26}$ ]] || continue
			# Short API calls here (8 s including curl's retries), so the confirmation window below
			# outlasts another agent's PATCH.
			IBX_MAXTIME=8
			m=$(api GET "/v1/machines/$id") || { fatal_check; apierr=1; continue; }
			[ "$(jq -r --argjson now "$(date +%s)" --argjson stale "$STALE_SECS" "$JQ_DEFS"' free($now; $stale)' <<<"$m")" = true ] || continue
			name=$(jq -r "$JQ_DEFS"' .name | clean' <<<"$m")
			if [ "${IBX_ALLOW_VAULT:-}" != 1 ]; then
				n=$(vault_items "$id" "${b:-${name:-$id}}") || { fatal_check; apierr=1; continue; }
				[ "$n" = 0 ] || { warn "skipping $name: the Vault writes $n secret(s) into it"; continue; }
			fi
			secret_rc=0
			secrets_state "$id" || secret_rc=$?
			fatal_check
			# An unreadable state is an API failure (125 if nothing else is free), not a busy pool.
			if [ "$secret_rc" = 2 ]; then apierr=1; warn "skipping $name: could not inspect its Org Secrets"; continue; fi
			[ "$secret_rc" = 0 ] || { warn "skipping $name: Org Secrets are selected, pending or left behind in it"; continue; }
			claim_lock
			fresh=$(all_machines) || { claim_unlock; fatal_check; apierr=1; continue; }
			ms=$fresh
			claim_limit "$fresh" "$token"
			m=$(jq -c --arg id "$id" '.[] | select(.id == $id)' <<<"$fresh")
			if [ -z "$m" ] || [ "$(jq -r --argjson now "$(date +%s)" --argjson stale "$STALE_SECS" \
				"$JQ_DEFS"' inpool and free($now; $stale) and available($now)' <<<"$m")" != true ]; then
				claim_unlock
				continue
			fi
			name=$(jq -r "$JQ_DEFS"' .name | clean' <<<"$m")
			claim=$(jq -cn --arg by "$AGENT" --arg at "$(now_iso)" --arg start "$(now_precise)" --arg p "${purpose:0:500}" --arg t "$token" \
				'{"ibx.claim.by":$by, "ibx.claim.at":$at, "ibx.claim.start":$start, "ibx.claim.purpose":$p, "ibx.claim.token":$t}')
			claimed_ids+=("$id")
			write_rc=0
			CLAIM_WRITE_TOKEN=$token set_claim "$id" "$claim" || write_rc=$?
			# Release compares ibx.claim.start with ports' createdAt, which is server time. When the
			# PATCH reply shows the write moved updatedAt forward, that is the server time of the
			# claim: store it instead of this computer's clock.
			if [ "$write_rc" = 0 ]; then
				server_start=$(jq -r --slurpfile before "$tmp/meta-before" "$JQ_DEFS"'
					(.updatedAt | timestamp) as $after | ($before[0].updatedAt | timestamp) as $prior |
					if $after != null and $prior != null and $after > $prior then .updatedAt | clean else empty end' \
					"$tmp/meta-response") || server_start=
				if [ -n "$server_start" ]; then
					claim=$(jq -c --arg s "$server_start" '.["ibx.claim.start"] = $s' <<<"$claim")
					CLAIM_WRITE_TOKEN=$token set_claim "$id" "$claim" || write_rc=$?
				fi
			fi
			claim_unlock
			if [ "$write_rc" != 0 ]; then
				[ "$write_rc" = 2 ] || apierr=1
				continue
			fi
			# Metadata has no compare-and-swap and the last writer wins: wait out another agent's
			# PATCH, then check that the reservation is still ours, twice.
			ok=1
			for wait in ${IBX_CLAIM_SETTLE:-20 5}; do # tests shorten it
				sleep_for "$wait"
				m=$(api GET "/v1/machines/$id") || { ok=''; apierr=1; break; }
				[ "$(jq -r '.metadata["ibx.claim.token"] // ""' <<<"$m")" = "$token" ] || { ok=''; break; }
			done
			IBX_MAXTIME=''
			[ -n "$ok" ] || continue
			ensure_running "$id" || { fatal_check; warn "$name would not start; trying another"; set_claim "$id" '{}' || true; continue; }
			LABEL=$name
			sweep_jobs "$id" claim "$token"
			m=$(api GET "/v1/machines/$id") || die "could not read the claimed sandbox"
			pauses=$(jq -c "$JQ_DEFS"' pauses' <<<"$m")
			cooldown=$(jq -c '.cooldownUntil // null' <<<"$m")
			if jq -e "$JQ_DEFS"' (pauses | timestamp) as $p | $p != null and $p - now < 3600' <<<"$m" >/dev/null; then warn "$name has under 60 minutes left before its max-run pause"; fi
			kept_claim=$(jq -cn --arg n "$name" --arg id "$id" '[{name:$n,id:$id}]')
			claimed_ids=("${claimed_ids[@]/$id/}") # ours to keep: do not clear it on exit
			# Keep it awake from now on; a keepalive timer renews this lease while it is reserved.
			echo '{"ttlSeconds":3600}' >"$tmp/lease"
			lease=null
			if lease_reply=$(api PUT "/v1/machines/$id/activity-leases/$LEASE" "$tmp/lease" 2>/dev/null); then
				lease=$(jq -c "$JQ_DEFS"' .expiresAt | clean' <<<"$lease_reply")
			else
				fatal_check
				warn "could not set the activity lease on $name: it may pause after 30 idle minutes"
			fi
			port_rows='[]'
			if ! ports=$(public_ports "$id"); then
				warn "could not list the public ports of $name; check with ibx release"
				port_rows=null
			elif [ -n "$ports" ]; then
				warn "WARNING: $name still has public ports from before (no authentication):"
				while IFS=$'\037' read -r port pname url created; do
					[[ $port =~ ^[0-9]+$ ]] || continue
					if [ -n "$JSON" ]; then warn "  $port $pname $url"; else stderr printf '  %s %s %s\n' "$port" "$pname" "$url"; fi
					port_rows=$(jq -c --argjson p "$port" --arg n "$pname" --arg u "$url" '. + [{port:$p,name:$n,url:$u}]' <<<"$port_rows")
				done <<<"$ports"
			fi
			if [ -n "$JSON" ]; then
				jq -cn --arg n "$name" --arg id "$id" --argjson c "$claim" --argjson l "$lease" \
					--argjson p "$port_rows" --argjson pause "$pauses" --argjson cool "$cooldown" '{pausesAt:$pause,cooldownUntil:$cool,name:$n,id:$id,by:$c["ibx.claim.by"],since:$c["ibx.claim.at"],
					purpose:$c["ibx.claim.purpose"],leaseUntil:$l,publicPorts:$p}' >"$tmp/result"
			else
				printf '%s\n' "$name"
				stderr printf 'ibx: use the literal name %s in later calls; release with ibx release %s; find it again with ibx ls --mine\n' "$name" "$name"
			fi
			exit 0
		done
		IBX_MAXTIME=''
		if [ "$attempt" != 1 ] || ! jq -e "$JQ_DEFS"' any(.[] | select(inpool); .state | IN("starting","resuming","suspending","stopping","creating"))' <<<"$ms" >/dev/null; then
			break
		fi
		sleep_for 20 # some were changing state: look once more
	done
	fatal_check
	[ -z "$apierr" ] || die "could not claim a sandbox: API errors (see above)"
	claim_limit "$ms" "$token"
	held=$(held_claims "$ms")
	message='no free sandbox in the pool (ibx ls). Ask the user before using one someone else holds.'
	stderr printf 'ibx: %s\n' "$message"
	stderr jq -r '.[] | "  \(.name): held by \(.by) since \(.since): \(.purpose)"' <<<"$held"
	json_error no_free_sandbox "$message" "$held"
	exit 75
	;;
renew)
	[ $# -ge 1 ] || die "usage: ibx renew <box>"
	id=$(resolve --pool "$1")
	m=$(api GET "/v1/machines/$id") || die "could not read $1"
	fresh_holder "$m" "$1"
	[ -n "$(jq -r '.metadata["ibx.claim.token"] // ""' <<<"$m")" ] || die "$1 has no reservation to renew (ibx claim)"
	since=$(now_iso)
	set_meta "$id" '. + {"ibx.claim.at": $at}' --arg at "$since" || die "could not renew $1"
	abandoned=$(jq -nr --arg at "$since" --argjson s "$STALE_SECS" '$at | fromdateiso8601 + $s | todate')
	if [ -n "$JSON" ]; then
		jq -c --arg since "$since" --arg a "$abandoned" "$JQ_DEFS"'
			{name:(.name | clean),id:(.id | clean),by:(.metadata["ibx.claim.by"] | clean),since:$since,abandonedAfter:$a}' <<<"$m" >"$tmp/result"
	else
		echo "renewed $1; it counts as abandoned after $abandoned"
	fi
	;;
release)
	args=()
	for a in "$@"; do
		case $a in
		--no-check) RELEASE_NO_CHECK=1 ;;
		*) args+=("$a") ;;
		esac
	done
	set -- "${args[@]}"
	[ $# -eq 1 ] || die "usage: ibx release [--no-check] [--json] <box> | --mine"
	if [ "$1" = --mine ]; then
		if [ "$AGENT_SOURCE" = 'per host' ]; then
			message='release --mine needs a session ID or IBX_AGENT_NAME; the per-host identity may be shared by other agents; release each literal name instead'
			json_error ambiguous_identity "$message"
			die "$message"
		fi
		ms=$(all_machines) || die "could not list sandboxes"
		held=$(held_claims "$ms" "$AGENT")
		released='[]' failed='[]'
		# Wait in the background. A foreground subshell would hold this trap until the release
		# finished, and the interrupt would then hide a reservation that release had already cleared.
		trap 'note_bulk_signal INT 130' INT
		trap 'note_bulk_signal TERM 143' TERM
		while IFS= read -r id; do
			[ -z "$bulk_signal" ] || break
			name=$(jq -r --arg id "$id" "$JQ_DEFS"' .[] | select(.id == $id) | .name | clean' <<<"$ms")
			rm -f "$tmp/release-rc"
			# Do not put the helper in an if condition: that disables its errexit too.
			release_isolated "$tmp/release-rc" "$id" >"$tmp/release-result" &
			release_pid=$!
			set +e
			wait "$release_pid"
			set -e
			if [ -n "$bulk_signal" ] && [ ! -s "$tmp/release-rc" ]; then
				set +e
				wait "$release_pid"
				set -e
			fi
			if [ -s "$tmp/release-rc" ]; then release_rc=$(cat "$tmp/release-rc"); else release_rc=125; fi
			rm -f "$tmp/release-rc"
			if [ "$release_rc" = 0 ]; then
				released=$(jq -c --arg n "$name" "$JQ_DEFS"' . + [($n | clean)]' <<<"$released")
				[ -n "$JSON" ] || printf 'released %s\n' "$name"
			else
				[ -s "$tmp/release-result" ] || printf '%s\n' '{"error":{"code":"failed","message":"release failed"}}' >"$tmp/release-result"
				failed=$(jq -c --arg n "$name" --slurpfile r "$tmp/release-result" "$JQ_DEFS"'
					. + [{name:($n | clean),error:($r[0].error // {code:"failed",message:"release failed"})}]' <<<"$failed")
			fi
			jq -c '.warnings[]?' "$tmp/release-result" >>"$tmp/warnings" || true
			[ -z "$bulk_signal" ] || break
		done < <(jq -r --arg by "$AGENT" --argjson now "$(date +%s)" --argjson stale "$STALE_SECS" "$JQ_DEFS"'
			.[] | select(inpool and .metadata["ibx.claim.by"] == $by) | age($now) as $age |
			select($age != null and $age != "invalid" and $age <= $stale) | .id' <<<"$ms")
		[ "$(jq length <<<"$held")" != 0 ] || warn "you hold no sandboxes"
		if [ -n "$bulk_signal" ]; then
			interrupt_detail=$(jq -rn --argjson released "$released" --argjson failed "$failed" --arg sig "$bulk_signal" '
				"interrupted by SIG\($sig): " +
				(if ($released | length) == 0 then "no box had been released"
				 else "released \($released | join(", "))" end) +
				(if ($failed | length) == 0 then ""
				 else "; not released: \($failed | map(.name) | join(", "))" end) +
				"; no further boxes were released"')
			interrupted "$bulk_signal" "$bulk_status"
		fi
		jq -cn --argjson released "$released" --argjson failed "$failed" '{released:$released,failed:$failed}' >"$tmp/result"
		[ "$(jq length <<<"$failed")" = 0 ] || exit 125
		exit 0
	fi
	release_box "$1"
	;;
exec)
	[ $# -ge 1 ] || die "usage: ibx exec <box> [-t SECS] [-i] -- <cmd>"
	STREAM=
	if [ "$1" = --stream ]; then STREAM=1; shift; fi
	[ $# -ge 1 ] || die "usage: ibx exec [--stream] <box> [-t SECS] [-i] -- <cmd>"
	box=$1
	shift
	t=300 stdin='' tailn=
	while [ $# -gt 0 ]; do
		case "$1" in
		-t) t=${2:-}; shift 2 || shift ;;
		-i) stdin=1; shift ;;
		--stream) STREAM=1; shift ;;
		--tail) tailn=${2:-}; shift 2 || shift ;;
		--) shift; break ;;
		*) break ;;
		esac
	done
	[[ $t =~ ^[0-9]+$ ]] || die "-t must be 1-600 seconds"
	t=$((10#$t))
	[ "$t" -ge 1 ] && [ "$t" -le 600 ] || die "-t must be 1-600 seconds"
	if [ -n "$tailn" ]; then
		[[ $tailn =~ ^[0-9]+$ ]] || die "--tail must be 1-2000 lines"
		tailn=$((10#$tailn))
		[ "$tailn" -ge 1 ] && [ "$tailn" -le 2000 ] || die "--tail must be 1-2000 lines"
	fi
	[ -z "$STREAM" ] || [ -z "$EXEC_JSON" ] || die "--json cannot be combined with --stream"
	[ -z "$STREAM" ] || [ -z "$tailn" ] || die "--tail cannot be combined with --stream"
	[ $# -gt 0 ] || die "usage: ibx exec [--json] [--stream] <box> [-t SECS] [-i] [--tail N] -- <cmd>"
	id=$(resolve --pool "$box")
	LABEL=$box
	cmd=$(remote_cmd "$@")
	[ -z "$tailn" ] || cmd=$(tail_wrapper "$tailn" "$cmd")
	if [ -n "$stdin" ]; then
		head -c 1048577 >"$tmp/stdin"
		[ "$(size_of "$tmp/stdin")" -le 1048576 ] || die "stdin is over 1 MiB: use ibx ssh"
		exec_in "$id" "$t" "$cmd" "$tmp/stdin"
	else
		exec_in "$id" "$t" "$cmd"
	fi
	r=$R
	if [ -n "$EXEC_JSON" ]; then
		full=$(jq -r '.stderr // ""' <<<"$r" | sed -n 's/^\[ibx: full output \(.*\), [0-9][0-9]* lines\]$/\1/p' | head -n 1)
		timed=$(jq -r '.timedOut // false' <<<"$r")
		[ "$(jq -r '.truncated // false' <<<"$r")" = true ] && warn "output truncated (1 MiB per stream)"
		[ "$(jq -r '.invalidUtf8 // false' <<<"$r")" = true ] && warn "output was not UTF-8 and was altered (bytes became U+FFFD); copy files with ibx get"
		signal=$(jq -r "$JQ_DEFS"' .signal // empty | clean' <<<"$r" | printable)
		[ -z "$signal" ] || warn "the remote command was killed by SIG$signal"
		disk=$(jq -r "$JQ_DEFS"' .diskWarning.message // empty | clean' <<<"$r" | printable)
		[ -z "$disk" ] || warn "$disk"
		[ "$timed" = true ] && warn "timed out after ${t}s; the command may have run partly"
		jq -n --arg box "$box" --argjson r "$r" --arg full "$full" --arg timed "$timed" --arg t "$t" '
			{box:$box, ran:(if $timed == "true" then "partial" else "yes" end),
			 exitCode:$r.exitCode, timedOut:($timed == "true"), signal:($r.signal // null),
			 truncated:($r.truncated // false), invalidUtf8:($r.invalidUtf8 // false),
			 stdout:($r.stdout // ""), stderr:($r.stderr // ""), warnings:[]}
			+ (if $full == "" then {} else {fullLog:$full} end)
			+ (if $timed == "true" then {error:{code:"timed_out", message:("timed out after " + $t + "s; the command may have run partly")}} else {} end)' >"$tmp/result"
		[ "$timed" = true ] && exit 124
		exit "$(jq -r '.exitCode // 125' <<<"$r")"
	fi
	jq -j '.stdout // ""' <<<"$r"
	stderr jq -j '.stderr // ""' <<<"$r"
	[ "$(jq -r '.truncated // false' <<<"$r")" = true ] && warn "output truncated (1 MiB per stream)"
	if [ "$(jq -r '.timedOut // false' <<<"$r")" = true ]; then
		warn "timed out after ${t}s; the command may never have started if the sandbox was slow; for long jobs run them detached: setsid -f CMD </dev/null >LOG 2>&1"
		exit 124
	fi
	rc=$(jq -r '.exitCode // 125' <<<"$r")
	[ "$(jq -r '.invalidUtf8 // false' <<<"$r")" != true ] || warn "output was not UTF-8 and was altered (bytes became U+FFFD); copy files with ibx get"
	signal=$(jq -r "$JQ_DEFS"' .signal // empty | clean' <<<"$r" | printable)
	[ -z "$signal" ] || warn "the remote command was killed by SIG$signal"
	disk=$(jq -r "$JQ_DEFS"' .diskWarning.message // empty | clean' <<<"$r" | printable)
	[ -z "$disk" ] || warn "$disk"
	exit "$rc"
	;;
put)
	force='' untracked=''
	excludes=()
	while [ $# -gt 0 ]; do
		case $1 in
		--force) force=1; shift ;;
		--untracked) untracked=1; shift ;;
		--exclude) [ $# -ge 2 ] || die "--exclude needs a glob"; excludes+=("$2"); shift 2 ;;
		*) break ;;
		esac
	done
	[ $# -eq 3 ] || die "usage: ibx put [--force] [--untracked] [--exclude GLOB] <box> <local> <remote>"
	box=$1 src=$2 dst=${3#\~/} # remote paths are relative to HOME already
	[ "$dst" != '~' ] && [ -n "$dst" ] || die "give a file path for the sandbox (relative to HOME)"
	if [ -d "$src" ]; then put_tree "$box" "$src" "$dst"; fi
	[ -f "$src" ] || die "no file $src"
	[ -r "$src" ] || die "cannot read $src"
	# /dev/stdin and the fd names are whatever stdin and fds the process opening them has (curl's
	# stdin carries the key header): refuse names that stay such an alias, and use the physical
	# path for every read below. Pseudo-files can expose process environments or lie about size;
	# the identity check also refuses paths that phys truncated at a trailing newline.
	path=$(phys "$src")
	for p in "$src" "$path"; do
		case $p in /proc | /proc/* | /sys | /sys/* | /dev | /dev/*) die "put copies a named file, not $src: give the file's own path" ;; esac
	done
	[ -f "$path" ] && [ -r "$path" ] && [ "$src" -ef "$path" ] || die "cannot read $src"
	if [ -z "$force" ] && { looks_secret "$src" || looks_secret "$path"; }; then
		die "$src looks like a credential; credentials never go to a sandbox (--force if it is really not one)"
	fi
	[ "$(size_of "$path")" -le 5368709120 ] || die "put exceeds the server limit of 5 GiB"
	id=$(resolve --pool "$box")
	LABEL=$box
	case $dst in /*) remote=$dst ;; *) remote=/data/home/$dst ;; esac
	file_rc=0
	file_api PUT "$id" "$remote" "$path" || file_rc=$?
	[ "$file_rc" != 3 ] || die "destination is a directory: give the file name too"
	if [ "$file_rc" = 0 ]; then
		[ "$(file_sha "$path")" = "$(jq -r .sha256 "$tmp/file-body")" ] || die "uploaded file SHA-256 does not match the local file"
		echo "copied $src -> $box:$dst"
		exit 0
	fi
	warn "this server has no file routes; falling back to exec with its 750 KB limit"
	[ "$(size_of "$path")" -le 750000 ] || die "$src is over 750 KB: tar c FILES | ibx ssh $box 'tar x -C DIR'"
	base64 <"$path" | tr -d '\n' >"$tmp/in"
	id=$(resolve --pool "$box")
	LABEL=$box
	q=$(printf %q "$dst")
	# Runs in the sandbox (Debian, GNU coreutils).
	EXEC_SAFE=1 exec_in "$id" 120 "[ ! -d $q ] || { echo 'destination is a directory: give the file name too' >&2; exit 3; }
mkdir -p -- \"\$(dirname -- $q)\" && { base64 -d >$q.ibx-part || { rm -f -- $q.ibx-part; exit 1; }; } && mv -fT -- $q.ibx-part $q" "$tmp/in"
	r=$R
	[ "$(jq -r .exitCode <<<"$r")" = 0 ] || die "put failed: $(jq -r .stderr <<<"$r" | printable)"
	echo "copied $src -> $box:$dst"
	;;
get)
	[ $# -ge 2 ] || die "usage: ibx get <box> <remote> [local]"
	box=$1 src=${2#\~/} dst=${3:-$(basename -- "$2")}
	[ "$src" != '~' ] && [ -n "$src" ] || die "give a file path in the sandbox (relative to HOME)"
	[[ $src == */ ]] && get_tree "$box" "$src" "$dst"
	[ -d "$dst" ] && dst=${dst%/}/$(basename -- "$src")
	LABEL=$box
	id=$(resolve --pool "$box")
	ensure_running "$id" || die "could not start $box for file transfer"
	case $src in /*) remote=$src ;; *) remote=/data/home/$src ;; esac
	stage=$(mktemp "$(dirname -- "$dst")/.ibx-get.XXXXXX") || die "could not stage download"
	remove_download() { rm -f "$stage"; }
	cleanup_fns+=(remove_download)
	file_rc=0
	file_api GET "$id" "$remote" "$stage" || file_rc=$?
	[ "$file_rc" != 3 ] || get_tree "$box" "$src" "$dst"
	if [ "$file_rc" = 0 ]; then
		mv -f -- "$stage" "$dst" || die "could not write $dst"
		echo "copied $box:$src -> $dst"
		exit 0
	fi
	warn "this server has no file routes; falling back to exec with its 750 KB limit"
	id=$(resolve --pool "$box")
	LABEL=$box
	q=$(printf %q "$src")
	# Runs in the sandbox (Debian, GNU coreutils).
	EXEC_SAFE=1 exec_in "$id" 120 "[ -f $q ] || { echo 'not a regular file' >&2; exit 3; }; s=\$(stat -L -c %s -- $q); [ \"\$s\" -le 750000 ] || { echo \"\$s bytes is over 750 KB: use ibx ssh BOX 'cat FILE' >LOCAL\" >&2; exit 4; }; head -c 750001 -- $q | base64 -w0"
	r=$R
	[ "$(jq -r .exitCode <<<"$r")" = 0 ] || die "get failed: $(jq -r .stderr <<<"$r" | printable)"
	[ "$(jq -r '.truncated // false' <<<"$r")" = true ] && die "get failed: output truncated"
	jq -r .stdout <<<"$r" | base64 --decode >"$tmp/out" || die "get failed: bad data"
	[ "$(size_of "$tmp/out")" -le 750000 ] || die "get failed: the file grew while copying"
	mv -f -- "$tmp/out" "$dst" || die "could not write $dst"
	echo "copied $box:$src -> $dst"
	;;
ssh | forward)
	[ $# -ge 1 ] || die "usage: ibx ssh <box> [cmd...]"
	box=$1
	shift
	[ "${1:-}" != -- ] || shift
	id=$(resolve --pool "$box")
	ensure_running "$id" || die "could not start $box"
	info=$(api GET "/v1/machines/$id/connection-info") || die "could not read connection info"
	host=$(jq -r .host <<<"$info")
	port=$(jq -r .port <<<"$info")
	hostkey=$(jq -r .hostTrust.publicKey <<<"$info")
	[[ $host =~ ^[A-Za-z0-9.-]+$ && $port =~ ^[0-9]+$ && $hostkey =~ ^ssh-[a-z0-9-]+\ [A-Za-z0-9+/=]+$ ]] ||
		die "unexpected connection info from the API"
	if [ "$port" = 22 ]; then hp=$host; else hp="[$host]:$port"; fi
	printf '@cert-authority %s %s\n' "$hp" "$hostkey" >"$tmp/kh"
	jq -n --arg n "ibx $AGENT" '{name:$n, ttlSeconds:3600}' >"$tmp/tokreq"
	tok=$(api POST "/v1/machines/$id/ssh-tokens" "$tmp/tokreq") || die "could not create an SSH token"
	tid=$(jq -r .id <<<"$tok")
	[[ $tid =~ ^[a-z0-9_]+$ ]] || die "unexpected token id"
	revoke() { # a DELETE lost to a dropped connection can leave the token live: confirm revokedAt
		local i r
		for i in 1 2 3; do
			printf '%s\n' "$AUTH" | curl -q -g -sS -o /dev/null -m 20 --retry 2 --retry-all-errors -X DELETE -H @- \
				"$API/v1/machines/$id/ssh-tokens/$tid" 2>/dev/null || true
			r=$(api GET "/v1/machines/$id/ssh-tokens" 2>/dev/null) || continue
			[ "$(jq -r --arg t "$tid" '[.tokens[]? | select(.id == $t) | .revokedAt // empty] | length' <<<"$r")" = 1 ] && return 0
			sleep 2
		done
		warn "WARNING: SSH token $tid may NOT be revoked; it expires within 1 hour"
	}
	cleanup_fns+=(revoke)
	user=$(jq -r .token <<<"$tok")
	[[ $user =~ ^ibssh_[a-z2-7]+$ ]] || die "unexpected token format"
	# The token is the SSH user name: keep it in a 0600 config file (umask 077), out of argv and
	# out of error output.
	printf 'Host ibx\n  HostName %s\n  Port %s\n  User %s\n  UserKnownHostsFile "%s"\n  StrictHostKeyChecking yes\n  BatchMode yes\n  PubkeyAuthentication no\n  LogLevel ERROR\n  ConnectTimeout 20\n  ServerAliveInterval 30\n  ServerAliveCountMax 4\n' \
		"$host" "$port" "$user" "$tmp/kh" >"$tmp/ssh_config"
	unset tok user
	sshargs=(-F "$tmp/ssh_config")
	if [ "$cmd" = forward ]; then
		[ $# -gt 0 ] || die "usage: ibx forward <box> [LOCAL:]REMOTE..."
		jq -e '.capabilities | index("port-forwarding") != null' <<<"$info" >/dev/null || die "server does not support port-forwarding"
		sshargs+=(-N -o ExitOnForwardFailure=yes)
		for mapping in "$@"; do
			local_port=${mapping%%:*} remote_port=${mapping##*:}
			[[ $mapping =~ ^([0-9]+:)?[0-9]+$ ]] || die "forward ports must be [LOCAL:]REMOTE"
			[[ $local_port =~ ^[0-9]{1,5}$ && $remote_port =~ ^[0-9]{1,5}$ ]] || die "forward ports must be 1-65535"
			[ "$((10#$local_port))" -ge 1 ] && [ "$((10#$local_port))" -le 65535 ] &&
				[ "$((10#$remote_port))" -ge 1 ] && [ "$((10#$remote_port))" -le 65535 ] || die "forward ports must be 1-65535"
			sshargs+=(-L "127.0.0.1:$((10#$local_port)):127.0.0.1:$((10#$remote_port))")
		done
		sshargs+=(ibx)
		warn "private tunnel in the foreground; SSH token expires in 1 hour; the claim's lease keeps the sandbox awake"
	else
		sshargs+=(ibx)
		[ $# -gt 0 ] && sshargs+=(-- "$(remote_cmd "$@")")
	fi
	# Main-shell waits let a signal close the tunnel before revoking its token.
	mkfifo "$tmp/ssh-errors"
	LC_ALL=C awk '{ gsub(/ibssh_[a-z2-7]+/, "ibssh_***"); print; fflush() }' <"$tmp/ssh-errors" >&2 &
	ssh_filter_pid=$!
	exec_phase=partial
	ssh "${sshargs[@]}" <&0 2>"$tmp/ssh-errors" &
	ssh_pid=$!
	rc=0
	wait "$ssh_pid" || rc=$?
	ssh_pid=
	wait "$ssh_filter_pid" || true
	ssh_filter_pid=

	exit "$rc"
	;;
port)
	[ $# -ge 2 ] || die "usage: ibx port <box> <port> [name]"
	[[ $2 =~ ^[0-9]+$ ]] || die "port must be a number"
	id=$(resolve --pool "$1")
	name=$(printf '%s' "${3:-port}" | tr '\t\n\r' '   ' | printable)
	jq -n --argjson p "$((10#$2))" --arg n "ibx:${name:0:90}" '{port:$p, name:$n}' >"$tmp/port"
	r=$(api POST "/v1/machines/$id/ports" "$tmp/port") || die "could not publish port $2"
	jq -r "$JQ_DEFS"' .url | clean' <<<"$r"
	warn "this URL has NO authentication: anyone with it reaches the service. ibx unport $1 $2 (or ibx release) when done."
	;;
unport)
	[ $# -eq 2 ] || die "usage: ibx unport <box> <port>"
	[[ $2 =~ ^[0-9]+$ ]] || die "port must be a number"
	id=$(resolve --pool "$1")
	unpublish "$id" "$((10#$2))" || { stderr cat "$tmp/perr"; die "could not unpublish port $2"; }
	echo "unpublished port $2 of $1"
	;;
keepalive)
	# Free-plan idle pause is fixed at 30 minutes. Leases do not prevent max-run pauses.
	# An activity lease (1 h) keeps it awake; renewing it every 15 minutes from a timer keeps
	# reserved pool sandboxes (or, with --all, every pool sandbox) running while that timer runs.
	# Idle-paused ones are woken; manually paused and stopped ones are left alone.
	all=''
	for a in "$@"; do case "$a" in --all) all=1 ;; *) die "usage: ibx keepalive [--all]" ;; esac; done
	ms=$(all_machines) || die "could not list sandboxes"
	echo '{"ttlSeconds":3600}' >"$tmp/lease"
	fail=0
	while IFS=$'\037' read -r id name state auto cool; do
		[ -n "$id" ] || continue
		[[ $id =~ ^m_[a-z2-7]{26}$ ]] || continue
		# A cooldown ibx cannot read is left to the server, which refuses the lease if it applies.
		if jq -en --arg c "$cool" "$JQ_DEFS"' ($c | timestamp) as $c | $c != null and $c > now' >/dev/null; then
			echo "$name: max-run cooldown until $cool, skipped"
			continue
		fi
		if [ "$state" = running ] || { [ "$state" = suspended ] && [ -n "$auto" ]; }; then
			rm -f "$tmp/fatal"
			if r=$(api PUT "/v1/machines/$id/activity-leases/$LEASE" "$tmp/lease" 2>"$tmp/err"); then
				echo "$name: lease until $(jq -r .expiresAt <<<"$r")"
			elif [ "$(err_code "$tmp/err")" = machine_cooldown ]; then
				if [ -n "$cool" ]; then echo "$name: max-run cooldown until $cool, skipped"
				else echo "$name: max-run cooldown, retry after $(jq -r '.error.retryAfterSeconds // "unknown"' "$tmp/err") s, skipped"; fi
			elif [ "$(err_code "$tmp/err")" = max_run_disabled ]; then
				echo "$name: max-run is disabled (maxRunMinutes 0), skipped"
			elif [ -s "$tmp/fatal" ] && [ "$(jq -r .code "$tmp/fatal")" = account_blocked ]; then
				# The lease route does not list 402, but it wakes an idle-paused box first, and wake
				# does. A skip, not a failure: the installed systemd unit restarts failed runs
				# (Restart=on-failure), and a billing block a minute later cannot help. Other boxes
				# still get their leases (a running one needs no wake); the next tick tries again.
				echo "$name: account blocked by billing: $(jq -r .message "$tmp/fatal" | printable); skipped; the user must resolve it (ibx doctor shows the plan)"
			else
				echo "$name: FAILED $(jq -c '.error | {code, message, retryAfterSeconds}' <"$tmp/err" 2>/dev/null || head -c 200 "$tmp/err" | printable)"
				fail=1
			fi
		else
			echo "$name: $state, skipped"
		fi
	done < <(jq -r --argjson now "$(date +%s)" --argjson stale "$STALE_SECS" --arg all "$all" "$JQ_DEFS"'
		.[] | select(inpool) | select($all == "1" or (free($now; $stale) | not)) |
		[.id, (.name | clean), .state, (.autoSuspendedAt // ""), (.cooldownUntil // "" | clean)] | join("\u001f")' <<<"$ms")
	exit $fail
	;;
doctor)
	bad=0
	ok() { printf 'ok    %s\n' "$*"; }
	no() { # message next-step: a FAIL line, then what to do about it
		printf 'FAIL  %s\n      next: %s\n' "$1" "$2"
		bad=1
	}
	note() { printf 'warn  %s\n' "$*"; }
	why() { # error-file -> " (code: message)", or cleaned raw text if no envelope was found
		local e
		[ -s "$1" ] || return 0
		e=$(jq -Rr "$JQ_DEFS"' fromjson? | .error? | [.code?, .message?] |
			map(select(type == "string") | clean) | join(": ") | select(length > 0)' "$1" 2>/dev/null | printable)
		[ -n "$e" ] || e=$(head -c 300 "$1" | printable)
		e=${e//$'\n'/ } e=${e//$'\r'/ } e=${e//$'\t'/ }
		[ -z "$e" ] || printf ' (%s)' "${e:0:300}"
	}
	ok "ibx $IBX_VERSION, bash $BASH_VERSION"
	ok "agent: $AGENT ($AGENT_SOURCE); IBX_MAX_CLAIMS=$MAX_CLAIMS"
	if ! state_dir_ok; then
		note "state directory is not writable or safe for the local lock: ${STATE_DIR:-unknown}"
	fi
	while IFS= read -r p; do
		[ -n "$p" ] || continue
		case "$p" in *"needed only by"*) note "$p" ;; *) no "$p" "install or upgrade it (README: Install), then run ibx doctor again" ;; esac
	done < <(deps_ok)
	[ "$bad" = 0 ] || { echo "fix the dependencies above first"; exit 125; }
	if [ -n "${CLAUDE_CONFIG_DIR:-}" ] && [ ! -e "$CLAUDE_CONFIG_DIR/skills/ibx" ]; then
		if ! jq -e '.plugins // {} | to_entries | any(.[];
			(.key | split("@")[0]) == "ibx" and (.value | type == "array" and length > 0))' \
			"$CLAUDE_CONFIG_DIR/plugins/installed_plugins.json" >/dev/null 2>&1; then
			config=$(printf %q "$CLAUDE_CONFIG_DIR")
			note "Claude Code with CLAUDE_CONFIG_DIR=$config cannot see the ibx skill; run CLAUDE_CONFIG_DIR=$config ./install.sh --agents claude --no-bin, or link skills/ibx there"
		fi
	fi
	if load_key; then
		ok "API key found ($KEY_SOURCE)"
		ENV_KEY=''
		if me=$(api GET /v1/me 2>"$tmp/err"); then
			ok "API reachable at $API as $(jq -r '.login // .userId' <<<"$me" | printable)"
			if ms=$(all_machines 2>"$tmp/lerr"); then
				n=$(jq "$JQ_DEFS"' [.[] | select(inpool)] | length' <<<"$ms")
				total=$(jq length <<<"$ms")
				if [ "$n" = 0 ]; then no "the pool is empty ($total sandboxes in the account)" "the user adds a box created with --no-vault --secrets none: ibx pool add BOX"; else ok "pool: $n of $total sandboxes"; fi
			else
				# No list is not an empty pool: the per-box and port checks have nothing to check.
				ms=''
				next="run ibx doctor again"
				[ ! -s "$tmp/fatal" ] || next="the user fixes or replaces this key (README: Setup); never look for another one"
				no "could not list sandboxes$(why "$tmp/lerr"), so the per-box and public port checks did not run" "$next"
			fi
			while IFS=$'\037' read -r id name on; do
				[ -n "$id" ] || continue
				if v=$(vault_items "$id" 2>/dev/null); then
					if [ "$v" = 0 ]; then
						[ "$on" != true ] || note "$name has the Vault on (empty now): secrets added to the Vault later reach it"
					else no "$name receives $v Vault secret(s): claim skips it unless IBX_ALLOW_VAULT=1" "the user recreates it with --no-vault --secrets none, or takes it out of the pool: ibx pool rm $name"; fi
				else
					no "could not read the Vault of $name$(why "$tmp/verr")" "run ibx doctor again; a 403 means this key cannot inspect it (workspace key or another member's box): recreate it with --no-vault --secrets none"
				fi
			done < <(jq -r "$JQ_DEFS"' .[] | select(inpool) | [.id, (.name | clean), (vaulton | tostring)] | join("\u001f")' <<<"$ms")
			orgid=$(jq -r '.orgId // empty' <<<"$me")
			if [[ $orgid =~ ^[A-Za-z0-9_-]+$ ]] && org=$(api GET "/v1/orgs/$orgid" 2>"$tmp/orgplanerr"); then
				ok "org: $(jq -c '{tier,freeSandboxHoursLimit:.limits.freeSandboxHours,freeSandboxHoursUsed:.usage.freeSandboxHours,startsPerMinute:.limits.startsPerMinute,cardMissingAt,disabledAt}' <<<"$org" | printable); 0 free hours means no cap"
				if [ "$(jq -r .tier <<<"$org")" = free ] && command -v systemctl >/dev/null &&
					systemctl --user cat ibx-keepalive.service 2>/dev/null | grep -q -- '--all'; then note "keepalive --all cycles every free box through 8-hour max-run pauses and uses free hours"; fi
				if orgsecrets=$(api GET "/v1/orgs/$orgid/secrets" 2>"$tmp/orgerr"); then
					while IFS=$'\037' read -r secret risk; do
						[ -n "$secret" ] || continue
						if [ "$risk" = true ]; then no "unsafe Org Secret: $secret (env or unknown delivery, or a proxy Secret for every host)" "the user deletes it, or keeps the pool in an org without Org Secrets"; else note "Org Secret exists: $secret"; fi
					done < <(jq -r "$JQ_DEFS"' .items[]? | [(.name | clean), (scoped_proxy | not | tostring)] | join("\u001f")' <<<"$orgsecrets")
				elif [ "$(err_code "$tmp/orgerr")" = not_found ] && org_secrets_off; then ok "Org Secrets: none on this server (404, and usage says they are off)"
				else
					next="run ibx doctor again; if it fails again, show the user this error"
					case $(err_code "$tmp/orgerr") in missing_scope | insufficient_scope) next="the user gives this key the machines:read scope" ;; esac
					no "could not audit Org Secrets$(why "$tmp/orgerr")" "$next"
				fi
			else no "could not read the org plan$(why "$tmp/orgplanerr")" "run ibx doctor again; the key needs to belong to the org (GET /v1/orgs/ID)"; fi
			while IFS=$'\037' read -r id name; do
				[ -n "$id" ] || continue
				secret_rc=0
				IBX_ALLOW_SECRETS='' secrets_state "$id" || secret_rc=$?
				case $secret_rc in
				1) no "$name has Org Secrets selected, pending or left behind" "the user clears both selections (PATCH /v1/machines/ID/secrets {\"secrets\":[],\"envSecrets\":[]}) or recreates it with --no-vault --secrets none" ;;
				2) no "could not inspect the Org Secrets of $name$(why "$tmp/serr")" "run ibx doctor again; claim skips the box until it can be inspected" ;;
				esac
				ok "$name run budget: $(jq -c --arg id "$id" "$JQ_DEFS"' .[] | select(.id == $id) | {maxRunMinutes,pausesAt:pauses,cooldownUntil}' <<<"$ms" | printable)"
				if tokens=$(api GET "/v1/machines/$id/ssh-tokens" 2>"$tmp/tokenerr"); then
					while IFS= read -r token_name; do [ -z "$token_name" ] || note "$name has a long-lived SSH token: $token_name"; done < <(jq -r "$JQ_DEFS"' .tokens[]? | select(.revokedAt == null) | (.expiresAt | timestamp) as $e | select($e == null or $e > now + 3600) | .name | clean' <<<"$tokens")
				else no "could not audit SSH tokens for $name$(why "$tmp/tokenerr")" "run ibx doctor again"; fi
			done < <(jq -r "$JQ_DEFS"' .[] | select(inpool) | [.id,(.name | clean)] | join("\u001f")' <<<"$ms")
			if [ -z "$ms" ]; then :
			elif allports=$(api GET /v1/ports 2>"$tmp/porterr"); then
				while IFS=$'\037' read -r name port reserved; do
					[ -n "$name" ] || continue
					if [ "$reserved" = false ]; then no "$name has a public port without a reservation: $port" "if nobody needs it: ibx unport $name $port"; else note "$name has a non-ibx public port: $port"; fi
				done < <(jq -r --argjson ms "$ms" --argjson now "$(date +%s)" --argjson stale "$STALE_SECS" "$JQ_DEFS"' .ports[]? as $p | $ms[] | select(inpool and .id == $p.machineId) | (free($now;$stale) | not) as $held | select($held == false or (($p.name // "") | startswith("ibx:") | not)) | [(.name | clean),($p.port | tostring),($held | tostring)] | join("\u001f")' <<<"$allports")
			else no "could not audit public ports$(why "$tmp/porterr")" "run ibx doctor again"; fi

			if r=$(api GET /v1/usage 2>/dev/null); then ok "limits: $(jq -c '.limits | {maxMachines, machineSpec}' <<<"$r")"; fi
		else
			next="check the network and run ibx doctor again"
			[ ! -s "$tmp/fatal" ] || next="the user fixes or replaces this key (README: Setup); never look for another one"
			no "API call failed: $(jq -c '.error | {code, message, hint, requiredScopes}' <"$tmp/err" 2>/dev/null || head -c 200 "$tmp/err" | printable)" "$next"
		fi
	else
		no "no API key: set INSTABOX_API_KEY or write it to $KEYFILE (chmod 600)" "the user creates one (README: Setup, step 1)"
	fi
	if command -v systemctl >/dev/null && systemctl --user is-active -q ibx-keepalive.timer 2>/dev/null; then
		ok "keepalive timer active (systemd)"
	elif command -v launchctl >/dev/null && launchctl list 2>/dev/null | grep -q ibx-keepalive; then
		ok "keepalive agent loaded (launchd)"
	elif crontab -l 2>/dev/null | grep -q 'ibx keepalive'; then
		ok "keepalive in crontab"
	else
		note "no keepalive timer: a reserved sandbox can pause after its 1-hour lease runs out (see references/keepalive.md)"
	fi
	version_newer() { # $1 is newer than $2
		local IFS=. i x y
		local -a a b
		read -r -a a <<<"$1"
		read -r -a b <<<"$2"
		for i in 0 1 2; do
			x=${a[$i]:-0} y=${b[$i]:-0}
			[ "$x" -gt "$y" ] && return 0
			[ "$x" -lt "$y" ] && return 1
		done
		return 1
	}
	update_command() {
		local real dir gitroot
		real=$(phys "$0")
		dir=$(dirname -- "$real")
		if gitroot=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null); then
			printf 'git -C %q pull --ff-only' "$gitroot"
			return 0
		fi
		case $real in
		*/plugins/*) printf '%s' 'update the ibx plugin from its marketplace' ;;
		*) printf '%s' 'from a clone of https://github.com/hevlyo/ibx: ./install.sh --copy' ;;
		esac
	}
	if [ "${IBX_UPDATE_CHECK:-1}" != 0 ]; then
		cache=${STATE_DIR:-}/update-check
		now=$(date +%s)
		remote=
		if [ -n "$cache" ] && [ -s "$cache" ]; then
			read -r stamp remote <"$cache" || true
			[ -n "${stamp:-}" ] && [ "$((now - stamp))" -lt 86400 ] || remote=
		fi
		if [ -z "$remote" ]; then
			url=${IBX_UPDATE_URL:-https://github.com/hevlyo/ibx/releases/latest}
			redir=$(curl -q -sS -o /dev/null -w '%{redirect_url}' -m 5 "$url" 2>/dev/null) || redir=
			remote=$(printf '%s\n' "$redir" | sed -n 's|.*/v\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\).*|\1|p' | head -n 1)
			if [ -n "$remote" ] && [ -n "$cache" ] && mkdir -p -- "$(dirname -- "$cache")" 2>/dev/null; then
				printf '%s %s\n' "$now" "$remote" >"$cache" 2>/dev/null || true
			fi
		fi
		if [ -z "$remote" ]; then
			printf 'info  could not check for updates\n'
		elif version_newer "$remote" "$IBX_VERSION"; then
			note "ibx $remote is available; $(update_command)"
		fi
	fi
	declare -A skill_copies=()
	for root in "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills" "$HOME/.claude/skills" "$HOME/.agents/skills" \
		"${CODEX_HOME:-$HOME/.codex}/skills" "${XDG_CONFIG_HOME:-$HOME/.config}/opencode/skills"; do
		[ -f "$root/ibx/SKILL.md" ] || continue
		real=$(cd -- "$root/ibx" && pwd -P) || continue
		skill_copies[$real]=1
	done
	if [ -d "$HOME/.claude/plugins" ]; then
		while IFS= read -r skillfile; do
			real=$(cd -- "$(dirname -- "$skillfile")" && pwd -P) || continue
			skill_copies[$real]=1
		done < <(find "$HOME/.claude/plugins" -path '*/ibx/SKILL.md' -type f 2>/dev/null)
	fi
	[ "${#skill_copies[@]}" -le 1 ] || note "more than one ibx skill is visible (${#skill_copies[@]} copies); keep a single copy so agents do not follow two versions"
	if other=$(command -v ibx 2>/dev/null); then
		other_version=$("$other" --version 2>/dev/null || true)
		[ "$other_version" = "ibx $IBX_VERSION" ] || [ -z "$other_version" ] || note "ibx on PATH ($other) reports ${other_version:-nothing}, this script is ibx $IBX_VERSION"
	fi
	exit $((bad ? 125 : 0))
	;;
run)
	[ $# -ge 2 ] || die "usage: ibx run <box> <name> [--replace] -- <cmd>"
	box=$1 name=$2
	shift 2
	replace=0
	while [ $# -gt 0 ]; do
		case $1 in
		--replace) replace=1; shift ;;
		--) shift; break ;;
		*) break ;;
		esac
	done
	job_name_ok "$name" || die "job name must match [a-z0-9][a-z0-9._-]{0,39}"
	[ $# -gt 0 ] || die "usage: ibx run <box> <name> [--replace] -- <cmd>"
	id=$(resolve --pool "$box")
	LABEL=$box
	m=$(api GET "/v1/machines/$id") || die "could not read $box"
	token=$(jq -r '.metadata["ibx.claim.token"] // "-"' <<<"$m")
	[[ $token =~ ^[-A-Za-z0-9_]+$ ]] || token=-
	script=$(job_controller "$name" "$replace" "$token")
	remote_cmd "$@" >"$tmp/job-cmd"
	line=
	if exec_shot "$id" 60 "$script" "$tmp/job-cmd"; then
		ec=$(jq -r '.exitCode // 1' <<<"$R")
		line=$(jq -r '.stdout // ""' <<<"$R" | head -n 1)
		if [ "$ec" != 0 ]; then
			stderr jq -j '.stderr // ""' <<<"$R"
			die "run did not start: $(jq -r '.stderr // "the job was not started"' <<<"$R" | head -n 1 | printable)"
		fi
	else
		code=$(err_code "$tmp/err")
		case $code in
		quota_exceeded | machine_not_running | machine_cooldown | max_run_disabled | bad_request | not_found | permission_denied | bad_path | unauthenticated | api_key_expired | api_key_revoked | insufficient_scope | missing_scope)
			stderr cat "$tmp/err"
			die "run did not start" ;;
		esac
		fatal_check
		if exec_shot "$id" 30 "$(job_remote status "$name")"; then
			line=$(jq -r '.stdout // ""' <<<"$R" | head -n 1)
			[ "$line" != absent ] || die "run did not start"
		else
			die "run may have started; check with ibx job $box $name"
		fi
	fi
	[[ $line =~ ^started\ [a-z0-9][a-z0-9._-]{0,39}\ pgid\ ([0-9]+)$ ]] || die "run did not start"
	pgid=${BASH_REMATCH[1]}
	if [ -n "$JSON" ]; then
		jq -n --arg name "$name" --argjson pgid "$pgid" '{name:$name,pgid:$pgid}' >"$tmp/result"
	else
		printf 'started %s pgid %s\n' "$name" "$pgid"
	fi
	exit 0
	;;
job)
	[ $# -ge 1 ] || die "usage: ibx job <box> [name] [--tail N] [--wait S] [--kill]"
	box=$1
	shift
	name='' tail='' wait='' kill=''
	if [ $# -gt 0 ] && [[ $1 != --* ]]; then name=$1; shift; fi
	while [ $# -gt 0 ]; do
		case $1 in
		--tail) tail=${2:-}; shift 2 || shift ;;
		--wait) wait=${2:-}; shift 2 || shift ;;
		--kill) kill=1; shift ;;
		*) die "usage: ibx job <box> [name] [--tail N] [--wait S] [--kill]" ;;
		esac
	done
	[ -z "$name" ] || job_name_ok "$name" || die "job name must match [a-z0-9][a-z0-9._-]{0,39}"
	if [ -n "$tail" ]; then
		[[ $tail =~ ^[0-9]+$ ]] || die "--tail must be 1-2000 lines"
		tail=$((10#$tail))
		[ "$tail" -ge 1 ] && [ "$tail" -le 2000 ] || die "--tail must be 1-2000 lines"
	fi
	if [ -n "$wait" ]; then
		[[ $wait =~ ^[0-9]+$ ]] || die "--wait must be 1-540 seconds"
		wait=$((10#$wait))
		[ "$wait" -ge 1 ] && [ "$wait" -le 540 ] || die "--wait must be 1-540 seconds"
	fi
	if [ -z "$name" ]; then
		[ -z "$tail" ] && [ -z "$wait" ] && [ -z "$kill" ] || die "name the job to use --tail, --wait or --kill"
		mode='list'
		tout=30
		script=$(job_remote list)
	elif [ -n "$kill" ]; then
		mode='kill'
		tout=30
		script=$(job_remote kill "$name")
	elif [ -n "$wait" ]; then
		mode='wait'
		tout=$((wait + 30))
		script=$(job_remote wait "$name" "$wait")
	else
		mode='show'
		tout=30
		script=$(job_remote show "$name" "$tail")
	fi
	id=$(resolve --pool "$box")
	LABEL=$box
	exec_shot "$id" "$tout" "$script" || die "could not read jobs on $box"
	[ "$(jq -r '.exitCode // 1' <<<"$R")" = 0 ] || die "$(jq -r '.stderr // "could not read the job"' <<<"$R" | head -n 1 | printable)"
	text=$(jq -r '.stdout // ""' <<<"$R")
	if [ "$mode" = show ] || [ "$mode" = wait ] || [ "$mode" = kill ]; then
		status_line=${text%%$'\n'*}
		tail_text=
		if [ "$text" != "$status_line" ]; then tail_text=${text#*$'\n'}; tail_text=${tail_text#$'\n'}; fi
	else
		status_line=$text
		tail_text=
	fi
	if [ -n "$JSON" ]; then
		printf '%s\n' "$status_line" | jq -Rsc --arg tail "$tail_text" --arg mode "$mode" '
			[split("\n")[] | select(length > 0) | split("\t") | {name:.[0], state:.[1],
				rc:(if .[2] == "" then null else (.[2] | tonumber? // .[2]) end),
				started:(if .[3] == "" then null else .[3] end),
				elapsed:(if .[4] == "" then null else (.[4] | tonumber? // null) end)}] as $rows |
			if $mode == "list" then {jobs:$rows} else ($rows[0] + {tail:$tail}) end' >"$tmp/result"
	elif [ "$mode" = list ]; then
		if [ -z "$status_line" ]; then echo "no jobs"; else printf '%s\n' "$status_line" | table; fi
	else
		printf '%s\n' "$status_line"
		[ -z "$tail_text" ] || printf '%s\n' "$tail_text"
	fi
	exit 0
	;;
*) stderr usage; exit 125 ;;
esac
